---
import { site } from '../data/site';
import { mainServices } from '../data/services';
import { locations } from '../data/locations';

const topCities = locations.slice(0, 12);
---

<footer style="background:#1A0505; color:white; padding-top:4rem; padding-bottom:2rem">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12" style="border-bottom:1px solid rgba(255,255,255,0.1)">

      <!-- Column 1: Brand -->
      <div class="space-y-5">
        <a href="/" class="inline-block transition-transform hover:scale-105">
          <img src="/images/logo.webp" alt={site.name} class="h-10 w-auto" />
        </a>
        <!-- Address -->
        <address class="text-sm not-italic leading-relaxed" style="color:rgba(255,255,255,0.55); font-family:'Inter',sans-serif">
          {site.address.street}<br />
          {site.address.city}, {site.address.state} {site.address.zip}
        </address>
        <p class="text-sm leading-relaxed" style="color:rgba(255,255,255,0.55); font-family:'Inter',sans-serif">
          Georgia's most trusted demolition and removal specialists. Licensed, insured, and serving all 159 Georgia counties. Free on-site estimates.
        </p>
        <div class="space-y-2.5">
          <a href={`tel:${site.phone}`} class="flex items-center gap-2 text-sm transition-colors" style="color:rgba(255,255,255,0.6); font-family:'Inter',sans-serif" onmouseover="this.style.color='#FCA5A5'" onmouseout="this.style.color='rgba(255,255,255,0.6)'">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.13 11.8 19.79 19.79 0 0 1 1.06 3.18 2 2 0 0 1 3.03 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16.92z"/></svg>
            {site.phone}
          </a>
          <a href={`mailto:${site.email}`} class="flex items-center gap-2 text-sm transition-colors" style="color:rgba(255,255,255,0.6); font-family:'Inter',sans-serif" onmouseover="this.style.color='#FCA5A5'" onmouseout="this.style.color='rgba(255,255,255,0.6)'">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            {site.email}
          </a>
        </div>
        {/* Social icons hidden — add real profiles later */}
        {false && <div class="flex gap-3 pt-1">
          <a href={site.social.facebook} class="w-9 h-9 rounded-lg flex items-center justify-center transition-colors" style="background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.6)" onmouseover="this.style.background='#C41C1C'; this.style.color='white'" onmouseout="this.style.background='rgba(255,255,255,0.08)'; this.style.color='rgba(255,255,255,0.6)'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href={site.social.instagram} class="w-9 h-9 rounded-lg flex items-center justify-center transition-colors" style="background:rgba(255,255,255,0.08); color:rgba(255,255,255,0.6)" onmouseover="this.style.background='#C41C1C'; this.style.color='white'" onmouseout="this.style.background='rgba(255,255,255,0.08)'; this.style.color='rgba(255,255,255,0.6)'">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Services -->
      <div>
        <h3 class="font-semibold text-sm mb-5 uppercase tracking-wider" style="font-family:'Outfit',sans-serif; color:#EF4444">Our Services</h3>
        <ul class="space-y-2.5">
          {mainServices.map(service => (
            <li>
              <a href={`/services/${service.slug}/`} class="text-sm transition-colors" style="color:rgba(255,255,255,0.6); font-family:'Inter',sans-serif" onmouseover="this.style.color='#FCA5A5'" onmouseout="this.style.color='rgba(255,255,255,0.6)'">
                {service.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/services/" class="text-sm font-semibold transition-colors" style="color:#EF4444; font-family:'Outfit',sans-serif" onmouseover="this.style.color='#FCA5A5'" onmouseout="this.style.color='#EF4444'">
              View All Services →
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Service Areas -->
      <div>
        <h3 class="font-semibold text-sm mb-5 uppercase tracking-wider" style="font-family:'Outfit',sans-serif; color:#EF4444">Service Areas</h3>
        <ul class="space-y-2.5">
          {topCities.map(loc => (
            <li>
              <a href={`/locations/${loc.slug}/`} class="text-sm transition-colors" style="color:rgba(255,255,255,0.6); font-family:'Inter',sans-serif" onmouseover="this.style.color='#FCA5A5'" onmouseout="this.style.color='rgba(255,255,255,0.6)'">
                {loc.name}, GA
              </a>
            </li>
          ))}
          <li>
            <a href="/locations/" class="text-sm font-semibold transition-colors" style="color:#EF4444; font-family:'Outfit',sans-serif" onmouseover="this.style.color='#FCA5A5'" onmouseout="this.style.color='#EF4444'">
              All 159 Counties →
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Quick Links + Trust Badges -->
      <div>
        <h3 class="font-semibold text-sm mb-5 uppercase tracking-wider" style="font-family:'Outfit',sans-serif; color:#EF4444">Quick Links</h3>
        <ul class="space-y-2.5 mb-8">
          {[
            { href: '/about/', label: 'About Us' },
            { href: '/contact/', label: 'Contact' },
            { href: '/faqs/', label: 'FAQs' },
            { href: '/privacy-policy/', label: 'Privacy Policy' },
            { href: '/terms-and-conditions/', label: 'Terms & Conditions' },
          ].map(link => (
            <li>
              <a href={link.href} class="text-sm transition-colors" style="color:rgba(255,255,255,0.6); font-family:'Inter',sans-serif" onmouseover="this.style.color='#FCA5A5'" onmouseout="this.style.color='rgba(255,255,255,0.6)'">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <!-- Trust badge -->
        <div class="rounded-xl p-4 space-y-2" style="background:rgba(255,255,255,0.06)">
          <div class="flex items-center gap-2 text-xs font-semibold text-white" style="font-family:'Outfit',sans-serif">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#EF4444" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Fully Licensed & Insured
          </div>
          <div class="text-xs" style="color:rgba(255,255,255,0.5); font-family:'Inter',sans-serif">Georgia demolition contractors · All 159 counties</div>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 pt-8">
      <p class="text-xs text-center md:text-left" style="color:rgba(255,255,255,0.4); font-family:'Inter',sans-serif">
        © {new Date().getFullYear()} Georgia Demolition & Removal. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a href="/privacy-policy/" class="text-xs transition-colors" style="color:rgba(255,255,255,0.4); font-family:'Inter',sans-serif" onmouseover="this.style.color='rgba(255,255,255,0.7)'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">Privacy Policy</a>
        <span style="color:rgba(255,255,255,0.2)">·</span>
        <a href="/terms-and-conditions/" class="text-xs transition-colors" style="color:rgba(255,255,255,0.4); font-family:'Inter',sans-serif" onmouseover="this.style.color='rgba(255,255,255,0.7)'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">Terms</a>
      </div>
    </div>
  </div>
</footer>
