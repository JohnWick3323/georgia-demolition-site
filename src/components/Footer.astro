---
import { site } from '../data/site';
import { mainServices } from '../data/services';
import { locations } from '../data/locations';

const topCities = locations.slice(0, 12);
---

<footer class="bg-neutral-900 text-white pt-16 pb-8">
  <div class="container mx-auto px-4 md:px-8 max-w-7xl">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12 border-b border-neutral-700 pb-12">
      <!-- Column 1: Brand -->
      <div class="space-y-5">
        <a href="/" class="inline-flex items-center gap-2 group">
          <div class="bg-primary-600 rounded p-1.5">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          </div>
          <div>
            <div class="font-heading font-bold text-base uppercase tracking-wide text-white">Georgia Demolition Experts</div>
          </div>
        </a>
        <p class="text-neutral-400 text-sm leading-relaxed">
          Georgia's most trusted demolition and removal specialists. Licensed, insured, and serving all 159 Georgia counties. Free on-site estimates.
        </p>
        <div class="space-y-2 text-sm text-neutral-400">
          <a href={`tel:${site.phone}`} class="flex items-center gap-2 hover:text-primary-400 transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {site.phone}
          </a>
          <a href={`mailto:${site.email}`} class="flex items-center gap-2 hover:text-primary-400 transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            contact@georgiademolitionandremoval.com
          </a>
        </div>
        <div class="flex gap-3">
          <a href={site.social.facebook} class="text-neutral-400 hover:text-primary-400 transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href={site.social.instagram} class="text-neutral-400 hover:text-primary-400 transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Services -->
      <div>
        <h3 class="font-heading font-bold text-base uppercase tracking-wide mb-5 text-white">Our Services</h3>
        <ul class="space-y-2.5">
          {mainServices.map(service => (
            <li>
              <a href={`/services/${service.slug}/`} class="text-neutral-400 hover:text-primary-400 text-sm transition-colors">
                {service.name}
              </a>
            </li>
          ))}
          <li>
            <a href="/services/" class="text-primary-500 hover:text-primary-400 text-sm font-semibold transition-colors">
              View All Services →
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Service Areas -->
      <div>
        <h3 class="font-heading font-bold text-base uppercase tracking-wide mb-5 text-white">Service Areas</h3>
        <ul class="space-y-2.5">
          {topCities.map(loc => (
            <li>
              <a href={`/locations/${loc.slug}/`} class="text-neutral-400 hover:text-primary-400 text-sm transition-colors">
                {loc.name}, GA
              </a>
            </li>
          ))}
          <li>
            <a href="/locations/" class="text-primary-500 hover:text-primary-400 text-sm font-semibold transition-colors">
              View All 76 Cities →
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Quick Links + CTA -->
      <div class="space-y-6">
        <div>
          <h3 class="font-heading font-bold text-base uppercase tracking-wide mb-5 text-white">Quick Links</h3>
          <ul class="space-y-2.5">
            <li><a href="/about/" class="text-neutral-400 hover:text-primary-400 text-sm transition-colors">About Us</a></li>
            <li><a href="/faqs/" class="text-neutral-400 hover:text-primary-400 text-sm transition-colors">FAQs</a></li>
            <li><a href="/blog/" class="text-neutral-400 hover:text-primary-400 text-sm transition-colors">Blog</a></li>
            <li><a href="/contact/" class="text-neutral-400 hover:text-primary-400 text-sm transition-colors">Contact</a></li>
            <li><a href="/privacy-policy/" class="text-neutral-400 hover:text-primary-400 text-sm transition-colors">Privacy Policy</a></li>
            <li><a href="/terms-and-conditions/" class="text-neutral-400 hover:text-primary-400 text-sm transition-colors">Terms & Conditions</a></li>
          </ul>
        </div>
        <div class="bg-primary-600 rounded-lg p-5">
          <p class="font-heading font-bold text-lg uppercase mb-2">Free Estimate</p>
          <p class="text-primary-100 text-sm mb-4">Licensed & insured. Serving all 159 Georgia counties. Get your free on-site estimate today.</p>
          <a href={`tel:${site.phone}`} class="flex items-center justify-center gap-2 bg-white text-primary-700 font-bold py-2.5 rounded font-heading uppercase text-sm tracking-wide hover:bg-gray-100 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {site.phone}
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-3 text-neutral-500 text-sm">
      <p>© {new Date().getFullYear()} Georgia Demolition Experts. All rights reserved.</p>
      <p>Licensed & Insured | Serving All 159 Georgia Counties</p>
    </div>
  </div>
</footer>
