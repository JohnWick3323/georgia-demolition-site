---
import { site } from '../data/site';

interface Props {
  heading?: string;
  subtext?: string;
}
const {
  heading = "Ready to Start Your Georgia Demolition Project?",
  subtext = "Licensed, insured & serving all 159 Georgia counties. Get your free on-site estimate today."
} = Astro.props;
---

<section class="py-16 text-white text-center bg-primary-600">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="font-bold text-white mb-4 font-heading cta-heading">{heading}</h2>
    <p class="text-lg mb-8 max-w-2xl mx-auto font-body cta-subtext">{subtext}</p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="/contact/" class="font-bold px-8 py-4 rounded-lg text-lg transition-all hover:-translate-y-0.5 shadow-lg font-heading cta-btn-primary">
        Get Free Estimate
      </a>
      <a href={`tel:${site.phoneRaw}`} class="font-bold px-8 py-4 rounded-lg text-lg transition-all hover:-translate-y-0.5 font-heading cta-btn-outline">
        {site.phone}
      </a>
    </div>
  </div>
</section>
