---
interface Props {
  title?: string;
  subtitle?: string;
  isDark?: boolean;
}

const { 
  isDark = false 
} = Astro.props;
---

<div class={`rounded-3xl border overflow-hidden ${isDark ? 'bg-neutral-900 border-neutral-800' : 'bg-white border-neutral-100 shadow-2xl'}`}>
  <iframe
    src="https://YOUR_GHL_FORM_URL/widget/form/YOUR_FORM_ID"
    style="width:100%;height:810px;border:none;border-radius:24px"
    id="inline-georgia-demolition-form"
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Georgia Demolition & Removal"
    data-height="810"
    data-layout-iframe-id="inline-georgia-demolition-form"
    data-form-id="YOUR_FORM_ID"
    title="Georgia Demolition & Removal Contact Form"
  >
  </iframe>
  <script src="https://YOUR_GHL_DOMAIN/js/form_embed.js"></script>
</div>
