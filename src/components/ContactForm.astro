---
interface Props {
  title?: string;
  subtitle?: string;
  isDark?: boolean;
  compact?: boolean;
}

const {
  title = "Get a Free Demolition Estimate",
  subtitle = "We respond within 1 business day. Serving all 159 Georgia counties statewide.",
  isDark = false,
  compact = false,
} = Astro.props;
---

<div class={`rounded-2xl overflow-hidden ${isDark ? 'bg-neutral-900 border border-neutral-800' : 'bg-white border border-neutral-100 shadow-xl'}`}>
  {(title || subtitle) && (
    <div class="px-6 pt-6 pb-2 text-center">
      {title && (
        <h3 class="font-bold mb-1" style={`font-family:'Outfit',sans-serif; font-size:1.25rem; color:${isDark ? 'white' : '#1A1A1A'}; text-align:center`}>
          {title}
        </h3>
      )}
      {subtitle && (
        <p class="text-sm mb-2" style={`font-family:'Inter',sans-serif; color:${isDark ? 'rgba(255,255,255,0.6)' : '#6B7280'}; text-align:center`}>
          {subtitle}
        </p>
      )}
    </div>
  )}
  <iframe
    src="https://link.westlanddre.com/widget/form/XoJVeWMaNl1Ss98RouWi"
    style={`width:100%;height:${compact ? '600px' : '831px'};border:none;`}
    id="inline-XoJVeWMaNl1Ss98RouWi"
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Georgia Demolition Form"
    data-height="831"
    data-layout-iframe-id="inline-XoJVeWMaNl1Ss98RouWi"
    data-form-id="XoJVeWMaNl1Ss98RouWi"
    title="Georgia Demolition Form"
  ></iframe>
</div>
<script src="https://link.westlanddre.com/js/form_embed.js"></script>
