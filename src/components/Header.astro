---
import { site } from '../data/site';
import { mainServices } from '../data/services';
---

{site.gtmId && (
  <Fragment>
    <script is:inline define:vars={{ gtmId: site.gtmId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer',gtmId);
    </script>
    <noscript>
      <iframe src={`https://www.googletagmanager.com/ns.html?id=${site.gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
  </Fragment>
)}

{site.ga4Id && (
  <Fragment>
    <script is:inline src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4Id}`} async></script>
    <script is:inline define:vars={{ ga4Id: site.ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga4Id);
    </script>
  </Fragment>
)}

<header id="site-header" class="fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-transparent text-white" style="height:72px">
  <div class="max-w-7xl mx-auto px-6 h-full flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center shrink-0 transition-transform hover:scale-105">
      <img src="/images/logo.webp" alt={site.name} id="header-logo" class="h-10 md:h-12 w-auto" />
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-7">
      <!-- Services dropdown -->
      <div class="relative group">
        <a href="/services/" class="flex items-center gap-1 font-semibold text-sm hover:text-primary-400 transition-colors py-2 font-heading">
          Services
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-180 transition-transform duration-200"><path d="m6 9 6 6 6-6"/></svg>
        </a>
        <div class="absolute top-full -left-4 bg-white shadow-xl rounded-xl opacity-0 translate-y-2 pointer-events-none group-hover:opacity-100 group-hover:translate-y-0 group-hover:pointer-events-auto transition-all duration-200 border border-neutral-100 mt-1 overflow-hidden" style="width:260px">
          {mainServices.map(s => (
            <a href={`/services/${s.slug}/`} class="flex items-center gap-3 px-5 py-3 text-sm text-neutral-700 hover:bg-primary-50 hover:text-primary-700 transition-colors border-b border-neutral-50 last:border-0 font-body">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="m9 18 6-6-6-6"/></svg>
              {s.name}
            </a>
          ))}
          <div class="px-5 py-3 bg-neutral-50">
            <a href="/services/" class="text-xs text-primary-600 font-semibold hover:text-primary-700 flex items-center gap-1 font-heading">
              View all services
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
      <a href="/locations/" class="font-semibold text-sm hover:text-primary-400 transition-colors font-heading">Service areas</a>
      <a href="/about/" class="font-semibold text-sm hover:text-primary-400 transition-colors font-heading">About us</a>
      <a href="/faqs/" class="font-semibold text-sm hover:text-primary-400 transition-colors font-heading">FAQs</a>
      <a href="/contact/" class="font-semibold text-sm hover:text-primary-400 transition-colors font-heading">Contact</a>
    </nav>

    <!-- Right: Phone + CTA -->
    <div class="flex items-center gap-3">
      <a href={`tel:${site.phone}`} class="hidden md:flex items-center gap-2 text-sm font-semibold hover:text-primary-400 transition-colors group font-body animate-pulse-ring rounded-full px-1">
        <div class="text-primary-500 group-hover:animate-bounce">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </div>
        {site.phone}
      </a>
      <a href="/contact/" class="bg-primary-600 hover:bg-primary-700 text-white px-5 py-2.5 rounded-lg font-semibold text-sm transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5 font-heading whitespace-nowrap">
        Free estimate
      </a>
      <!-- Mobile toggle -->
      <button id="mobile-menu-toggle" class="lg:hidden p-1.5 rounded" aria-label="Menu">
        <svg id="menu-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
        <svg id="close-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div id="mobile-menu" class="fixed inset-0 bg-white text-neutral-900 z-40 lg:hidden opacity-0 pointer-events-none transition-all duration-300 overflow-y-auto" style="top:72px">
  <div class="px-6 py-8 flex flex-col gap-0.5">
    <a href="/services/" class="py-3.5 px-4 text-base font-semibold border-b border-neutral-100 hover:text-primary-600 transition-colors font-heading">Services</a>
    {mainServices.map(s => (
      <a href={`/services/${s.slug}/`} class="py-2.5 px-8 text-sm text-neutral-600 hover:text-primary-600 transition-colors border-b border-neutral-50 flex items-center gap-2 font-body">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        {s.name}
      </a>
    ))}
    <a href="/locations/" class="py-3.5 px-4 text-base font-semibold border-b border-neutral-100 hover:text-primary-600 transition-colors font-heading">Service areas</a>
    <a href="/about/" class="py-3.5 px-4 text-base font-semibold border-b border-neutral-100 hover:text-primary-600 transition-colors font-heading">About us</a>
    <a href="/faqs/" class="py-3.5 px-4 text-base font-semibold border-b border-neutral-100 hover:text-primary-600 transition-colors font-heading">FAQs</a>
    <a href="/contact/" class="py-3.5 px-4 text-base font-semibold border-b border-neutral-100 hover:text-primary-600 transition-colors font-heading">Contact</a>
    <!-- Mobile emergency CTA card -->
    <div class="mt-6 p-6 rounded-xl text-white" style="background:#C41C1C">
      <p class="font-bold text-lg mb-1 font-heading">Need emergency demolition?</p>
      <p class="text-primary-100 text-sm mb-4 font-body">Our crews are available across all 159 Georgia counties.</p>
      <a href={`tel:${site.phone}`} class="flex items-center justify-center gap-3 bg-white py-3 rounded-lg font-bold font-heading group" style="color:#C41C1C">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:animate-bounce"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        {site.phone}
      </a>
    </div>
    <a href="/contact/" class="mt-3 text-center py-4 rounded-xl font-bold text-base border-2 font-heading" style="border-color:#C41C1C; color:#C41C1C">
      Get free estimate
    </a>
  </div>
</div>

<script>
  const header = document.getElementById('site-header') as HTMLElement;
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;
  const menuIcon = document.getElementById('menu-icon') as HTMLElement;
  const closeIcon = document.getElementById('close-icon') as HTMLElement;
  const logo = document.getElementById('header-logo') as HTMLImageElement;

  // Scroll behavior with logo swap
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      header.classList.remove('bg-transparent', 'text-white');
      header.classList.add('bg-white', 'text-neutral-900', 'shadow-md');
      if (logo) logo.src = '/images/logo-dark.webp';
    } else {
      if (!mobileMenu?.classList.contains('opacity-100')) {
        header.classList.add('bg-transparent', 'text-white');
        header.classList.remove('bg-white', 'text-neutral-900', 'shadow-md');
        if (logo) logo.src = '/images/logo.webp';
      }
    }
  });

  // Mobile menu toggle
  mobileToggle?.addEventListener('click', () => {
    const isOpen = !mobileMenu.classList.contains('pointer-events-none');
    if (isOpen) {
      mobileMenu.classList.add('opacity-0', 'pointer-events-none');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
      if (window.scrollY <= 50) {
        header.classList.add('bg-transparent', 'text-white');
        header.classList.remove('bg-white', 'text-neutral-900', 'shadow-md');
        if (logo) logo.src = '/images/logo.webp';
      }
    } else {
      mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      header.classList.remove('bg-transparent', 'text-white');
      header.classList.add('bg-white', 'text-neutral-900', 'shadow-md');
      if (logo) logo.src = '/images/logo-dark.webp';
    }
  });
</script>
