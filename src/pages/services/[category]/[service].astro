---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTASection from '../../../components/CTASection.astro';
import ContactForm from '../../../components/ContactForm.astro';
import FAQAccordion from '../../../components/FAQAccordion.tsx';
import { mainServices, type SubService, type MainService } from '../../../data/services';
import { site } from '../../../data/site';

export function getStaticPaths() {
  return mainServices.flatMap(ms =>
    ms.subServices.map(sub => ({
      params: { category: ms.slug, service: sub.slug },
      props: { service: sub, category: ms }
    }))
  );
}

interface Props {
  service: SubService;
  category: MainService;
}

const { service, category } = Astro.props;

const breadcrumbs = [
  { name: "Services", url: "/services/" },
  { name: category.name, url: `/services/${category.slug}/` },
  { name: service.name, url: `/services/${category.slug}/${service.slug}/` }
];

const faqSchema = service.faqs && service.faqs.length > 0 ? JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": service.faqs.map((faq: {question: string; answer: string}) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
}) : null;

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@id": `${site.url}/#organization` },
  "areaServed": { "@type": "State", "name": "Georgia" }
});
---

<BaseLayout
  title={`${service.name} in Georgia | ${site.name}`.length > 60 ? `${service.name} in Georgia` : `${service.name} in Georgia | ${site.name}`}
  description={service.metaDescription}
  breadcrumbs={breadcrumbs}
  schemaOverride={faqSchema ?? serviceSchema}
>
  <Header slot="header" />

  <!-- Breadcrumb -->
  <nav style="background:#F9FAFB; border-bottom:1px solid #E5E7EB; padding-top:72px">
    <div class="max-w-7xl mx-auto px-6 py-3">
      <ol class="flex items-center gap-2 text-xs flex-wrap" style="color:#6B7280; font-family:'Inter',sans-serif">
        <li><a href="/" class="hover:text-red-600 transition-colors">Home</a></li>
        <li style="color:#D1D5DB">/</li>
        <li><a href="/services/" class="hover:text-red-600 transition-colors">Services</a></li>
        <li style="color:#D1D5DB">/</li>
        <li><a href={`/services/${category.slug}/`} class="hover:text-red-600 transition-colors">{category.name}</a></li>
        <li style="color:#D1D5DB">/</li>
        <li style="color:#374151; font-weight:500">{service.name}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative text-white py-16" style={`background:linear-gradient(rgba(0,0,0,0.72),rgba(0,0,0,0.65)), url('${category.image || "/images/hero-services.webp"}') center/cover no-repeat`}>
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <div class="text-sm font-semibold mb-3" style="color:#FCA5A5; font-family:'Outfit',sans-serif">{category.name}</div>
        <h1 class="font-bold text-white mb-6" style="font-family:'Outfit',sans-serif; font-size:clamp(2rem,4.5vw,3rem); line-height:1.15">
          {service.heroHeading}
        </h1>
        <p class="text-lg mb-8" style="color:rgba(255,255,255,0.8); font-family:'Inter',sans-serif">
          {service.description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact/" class="font-bold px-8 py-3.5 rounded-lg transition-all hover:-translate-y-0.5 shadow-lg" style="background:#C41C1C; color:white; font-family:'Outfit',sans-serif">
            Get Free Estimate
          </a>
          <a href="tel:(843) 241-0787" class="border-2 border-white text-white font-bold px-8 py-3.5 rounded-lg transition-all hover:-translate-y-0.5" style="font-family:'Outfit',sans-serif">
            (843) 241-0787
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main -->
        <div class="lg:col-span-2 space-y-10">
          <!-- Intro -->
          <div>
            <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:1.8rem; color:#1A1A1A">
              About Our {service.name} Service
            </h2>
            <p class="leading-relaxed text-lg" style="color:#4B5563; font-family:'Inter',sans-serif">{service.longContent.intro}</p>
          </div>

          <!-- Features -->
          <div>
            <h2 class="font-bold mb-6" style="font-family:'Outfit',sans-serif; font-size:1.8rem; color:#1A1A1A">
              Key Features &amp; Benefits
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {service.features.map(feature => (
                <div class="flex items-start gap-3 p-4 rounded-xl" style="background:#F9FAFB; border:1px solid #E5E7EB">
                  <div class="w-7 h-7 rounded flex items-center justify-center shrink-0 mt-0.5" style="background:#C41C1C">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>
                  </div>
                  <span class="text-sm leading-relaxed font-medium" style="color:#374151; font-family:'Inter',sans-serif">{feature}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Methodology -->
          <div>
            <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:1.8rem; color:#1A1A1A">
              Our Approach &amp; Methodology
            </h2>
            <p class="leading-relaxed" style="color:#4B5563; font-family:'Inter',sans-serif">{service.longContent.methodology}</p>
          </div>

          <!-- Process -->
          <div>
            <h2 class="font-bold mb-6" style="font-family:'Outfit',sans-serif; font-size:1.8rem; color:#1A1A1A">
              Our Process
            </h2>
            <div class="space-y-4">
              {service.process.map((step, i) => (
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-base shrink-0" style="background:#C41C1C; font-family:'Outfit',sans-serif">
                    {i + 1}
                  </div>
                  <div class="pt-2">
                    <p class="leading-relaxed" style="color:#4B5563; font-family:'Inter',sans-serif">{step}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Local Advice -->
          <div class="rounded-xl p-6" style="background:#FEF2F2; border:1px solid #FECACA">
            <div class="flex items-start gap-3 mb-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-1"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <h2 class="font-bold" style="font-family:'Outfit',sans-serif; font-size:1.3rem; color:#7A1010">
                Georgia-Specific Information
              </h2>
            </div>
            <p class="leading-relaxed" style="color:#560A0A; font-family:'Inter',sans-serif">{service.longContent.localAdvice}</p>
          </div>

          <!-- FAQs -->
          <div>
            <h2 class="font-bold mb-6" style="font-family:'Outfit',sans-serif; font-size:1.8rem; color:#1A1A1A">
              Frequently Asked Questions
            </h2>
            <FAQAccordion faqs={service.faqs} client:load />
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- CTA Card -->
          <div class="rounded-xl p-6 text-white" style="background:#C41C1C">
            <h3 class="font-bold mb-3" style="font-family:'Outfit',sans-serif; font-size:1.1rem">Get a Free Estimate</h3>
            <p class="text-sm mb-4" style="color:rgba(255,255,255,0.85); font-family:'Inter',sans-serif">
              Licensed &amp; insured. Serving all 159 Georgia counties. Call or request online.
            </p>
            <div class="space-y-3">
              <a href="/contact/" class="block bg-white font-bold py-3 rounded-lg text-center text-sm transition-colors hover:bg-neutral-100" style="color:#C41C1C; font-family:'Outfit',sans-serif">
                Request Quote
              </a>
              <a href="tel:(843) 241-0787" class="block text-white font-bold py-3 rounded-lg text-center text-sm transition-colors border border-white/30 hover:bg-white/10" style="font-family:'Outfit',sans-serif">
                (843) 241-0787
              </a>
            </div>
          </div>

          <!-- Other services in category -->
          <div class="rounded-xl p-6" style="border:1px solid #E5E7EB; background:white">
            <h3 class="font-semibold mb-4 text-sm" style="font-family:'Outfit',sans-serif; color:#1A1A1A">Also in {category.name}</h3>
            <ul class="space-y-2">
              {category.subServices.filter(s => s.slug !== service.slug).slice(0, 8).map(s => (
                <li>
                  <a href={`/services/${category.slug}/${s.slug}/`} class="flex items-center gap-2 text-sm transition-colors hover:text-red-600" style="color:#6B7280; font-family:'Inter',sans-serif">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><polyline points="9 18 15 12 9 6"/></svg>
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Why Us -->
          <div class="rounded-xl p-6" style="background:#F9F9F9; border:1px solid #E5E7EB">
            <h3 class="font-semibold mb-4 text-sm" style="font-family:'Outfit',sans-serif; color:#1A1A1A">Why Choose Us</h3>
            <ul class="space-y-3">
              {["Licensed in all 159 GA counties","Fully insured (GL + Workers Comp)","Free on-site estimates","Georgia EPD compliant","Fast project mobilization","Expert hazmat handling"].map(item => (
                <li class="flex items-center gap-2 text-sm" style="color:#4B5563; font-family:'Inter',sans-serif">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="m20 6-11 11-5-5"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- GHL Contact Form -->
  <section class="py-20" style="background:#F5F3EF">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-bold mb-3 font-heading" style="font-size:2rem;color:#1A1A1A">
          Free <span style="color:#C41C1C">{service.name}</span> Estimate
        </h2>
        <p class="font-body" style="color:#6B7280">Serving all 159 Georgia counties. We respond within 1 business day.</p>
      </div>
      <ContactForm
        title={`Free ${service.name} Estimate`}
        subtitle={`Tell us about your ${service.name.toLowerCase()} project and we'll respond within 1 business day.`}
      />
    </div>
  </section>

  <CTASection heading={`Ready for ${service.name} in Georgia?`} />
  <Footer slot="footer" />
</BaseLayout>
