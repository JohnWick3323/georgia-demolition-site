---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTASection from '../../../components/CTASection.astro';
import FAQAccordion from '../../../components/FAQAccordion.tsx';
import { mainServices, type SubService, type MainService } from '../../../data/services';

export function getStaticPaths() {
  return mainServices.flatMap(ms =>
    ms.subServices.map(sub => ({
      params: { category: ms.slug, service: sub.slug },
      props: { service: sub, category: ms }
    }))
  );
}

interface Props {
  service: SubService;
  category: MainService;
}

const { service, category } = Astro.props;
---

<BaseLayout
  title={`${service.name} in Georgia | ${category.name}`}
  description={service.metaDescription}
>
  <Header slot="header" />

  <!-- Breadcrumb -->
  <nav class="bg-neutral-100 border-b border-neutral-200 pt-20">
    <div class="container mx-auto px-4 max-w-7xl py-3">
      <ol class="flex items-center gap-2 text-xs text-neutral-500 flex-wrap" style="text-transform:none;font-family:var(--font-body);">
        <li><a href="/" class="hover:text-primary-600">Home</a></li>
        <li class="text-neutral-300">/</li>
        <li><a href="/services/" class="hover:text-primary-600">Services</a></li>
        <li class="text-neutral-300">/</li>
        <li><a href={`/services/${category.slug}/`} class="hover:text-primary-600">{category.name}</a></li>
        <li class="text-neutral-300">/</li>
        <li class="text-neutral-700 font-medium">{service.name}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-primary-600 text-white py-16">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="max-w-3xl">
        <div class="text-primary-200 font-heading text-sm uppercase tracking-widest mb-3">{category.name}</div>
        <h1 class="text-5xl font-bold uppercase tracking-wide mb-6">{service.heroHeading}</h1>
        <p class="text-lg text-primary-100 mb-8" style="text-transform:none;font-family:var(--font-body);">
          {service.description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact/" class="bg-white text-primary-700 font-bold px-8 py-3 rounded font-heading uppercase tracking-wide hover:bg-gray-100 transition-all">Get Free Quote</a>
          <a href="tel:(843) 241-0787" class="bg-primary-800 text-white font-bold px-8 py-3 rounded font-heading uppercase tracking-wide hover:bg-primary-900 transition-all border border-primary-500">(843) 241-0787</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main -->
        <div class="lg:col-span-2 space-y-10">
          <!-- Intro -->
          <div>
            <h2 class="text-3xl font-bold uppercase tracking-wide mb-4">About Our {service.name} Service</h2>
            <p class="text-neutral-700 leading-relaxed text-lg" style="text-transform:none;font-family:var(--font-body);">{service.longContent.intro}</p>
          </div>

          <!-- Features -->
          <div>
            <h2 class="text-3xl font-bold uppercase tracking-wide mb-6">Key Features & Benefits</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {service.features.map(feature => (
                <div class="flex items-start gap-3 p-4 bg-neutral-50 rounded-lg border border-neutral-100">
                  <div class="w-8 h-8 bg-primary-600 rounded flex items-center justify-center shrink-0 mt-0.5">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>
                  </div>
                  <span class="text-sm text-neutral-700 leading-relaxed font-medium" style="text-transform:none;font-family:var(--font-body);">{feature}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Our Methodology -->
          <div>
            <h2 class="text-3xl font-bold uppercase tracking-wide mb-4">Our Approach & Methodology</h2>
            <p class="text-neutral-700 leading-relaxed" style="text-transform:none;font-family:var(--font-body);">{service.longContent.methodology}</p>
          </div>

          <!-- Process -->
          <div>
            <h2 class="text-3xl font-bold uppercase tracking-wide mb-6">Our Process</h2>
            <div class="space-y-4">
              {service.process.map((step, i) => (
                <div class="flex items-start gap-4">
                  <div class="w-10 h-10 bg-primary-600 rounded-full flex items-center justify-center text-white font-bold font-heading text-lg shrink-0">{i + 1}</div>
                  <div class="pt-2">
                    <p class="text-neutral-700 leading-relaxed" style="text-transform:none;font-family:var(--font-body);">{step}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Local Advice -->
          <div class="bg-primary-50 border border-primary-200 rounded-xl p-6">
            <div class="flex items-start gap-3 mb-3">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600 shrink-0 mt-1"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/></svg>
              <h2 class="text-2xl font-bold uppercase tracking-wide text-primary-800">Georgia-Specific Information</h2>
            </div>
            <p class="text-primary-900 leading-relaxed" style="text-transform:none;font-family:var(--font-body);">{service.longContent.localAdvice}</p>
          </div>

          <!-- FAQs -->
          <div>
            <h2 class="text-3xl font-bold uppercase tracking-wide mb-6">Frequently Asked Questions</h2>
            <FAQAccordion faqs={service.faqs} client:load />
          </div>
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- CTA Card -->
          <div class="bg-primary-600 text-white rounded-xl p-6">
            <h3 class="font-heading font-bold text-xl uppercase tracking-wide mb-3">Get a Free Estimate</h3>
            <p class="text-primary-100 text-sm mb-4" style="text-transform:none;font-family:var(--font-body);">Licensed & insured. Serving all 159 Georgia counties. Call or request online.</p>
            <div class="space-y-3">
              <a href="/contact/" class="block bg-white text-primary-700 font-bold py-3 rounded text-center font-heading uppercase tracking-wide text-sm hover:bg-gray-100 transition-colors">Request Quote</a>
              <a href="tel:(843) 241-0787" class="block bg-primary-800 text-white font-bold py-3 rounded text-center font-heading uppercase tracking-wide text-sm hover:bg-primary-900 transition-colors border border-primary-500">(843) 241-0787</a>
            </div>
          </div>

          <!-- Other services in category -->
          <div class="bg-white rounded-xl p-6 border border-neutral-200">
            <h3 class="font-heading font-bold text-base uppercase tracking-wide mb-4">Also in {category.name}</h3>
            <ul class="space-y-2">
              {category.subServices.filter(s => s.slug !== service.slug).slice(0, 8).map(s => (
                <li>
                  <a href={`/services/${category.slug}/${s.slug}/`} class="flex items-center gap-2 text-sm text-neutral-600 hover:text-primary-600 transition-colors" style="text-transform:none;font-family:var(--font-body);">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary-500 shrink-0"><polyline points="9 18 15 12 9 6"/></svg>
                    {s.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Why Us -->
          <div class="bg-neutral-50 rounded-xl p-6 border border-neutral-200">
            <h3 class="font-heading font-bold text-base uppercase tracking-wide mb-4">Why Choose Us</h3>
            <ul class="space-y-3">
              {["Licensed in all 159 GA counties","Fully insured (GL + Workers Comp)","Free on-site estimates","Georgia EPD compliant","Fast project mobilization","Expert hazmat handling"].map(item => (
                <li class="flex items-center gap-2 text-sm text-neutral-700" style="text-transform:none;font-family:var(--font-body);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600 shrink-0"><path d="m20 6-11 11-5-5"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection heading={`Ready for ${service.name} in Georgia?`} />
  <Footer slot="footer" />
</BaseLayout>
