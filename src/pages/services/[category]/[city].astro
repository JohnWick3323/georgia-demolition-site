---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import CTASection from '../../../components/CTASection.astro';
import { mainServices } from '../../../data/services';
import { locations } from '../../../data/locations';
import { combinations } from '../../../data/combinations';
import { site } from '../../../data/site';

export function getStaticPaths() {
  // Only generate for top 15 cities x 5 main services = 75 pages
  const topCitySlugs = ["atlanta","savannah","augusta","columbus","macon","athens","marietta","sandy-springs","alpharetta","warner-robins","valdosta","gainesville","dalton","rome","cumming"];
  return mainServices.flatMap(ms =>
    locations
      .filter(loc => topCitySlugs.includes(loc.slug))
      .map(loc => ({
        params: { category: ms.slug, city: loc.slug },
        props: { service: ms, location: loc }
      }))
  );
}

const { service, location } = Astro.props;

// Find combination data if it exists
const combo = combinations.find(
  c => c.serviceSlug === service.slug && c.locationSlug === location.slug
);

const titleFull = `${service.name} in ${location.name}, GA | ${site.name}`;
const title = titleFull.length > 60 ? `${service.name} in ${location.name}, GA` : titleFull;
const description = `Licensed ${service.name.toLowerCase()} in ${location.name}, Georgia. ${location.county} County experts for residential, commercial, and industrial projects. Free estimates — call ${site.phone}.`;

const breadcrumbs = [
  { name: "Services", url: "/services/" },
  { name: service.name, url: `/services/${service.slug}/` },
  { name: location.name, url: `/services/${service.slug}/${location.slug}/` }
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${service.name} in ${location.name}, GA`,
  "description": description,
  "areaServed": {
    "@type": "City",
    "name": location.name,
    "addressRegion": "GA"
  },
  "provider": {
    "@id": `${site.url}/#organization`
  }
};
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  schemaOverride={JSON.stringify(serviceSchema)}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="relative pt-24 pb-16" style={`background:linear-gradient(rgba(0,0,0,0.72),rgba(0,0,0,0.72)),url('${service.image || "/images/hero-services.webp"}') center/cover no-repeat; background-color:#1a0a0a`}>
    <div class="max-w-7xl mx-auto px-6">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center gap-2 text-xs flex-wrap" style="color:rgba(255,255,255,0.65)">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li style="color:rgba(255,255,255,0.4)">/</li>
          <li><a href="/services/" class="hover:text-white transition-colors">Services</a></li>
          <li style="color:rgba(255,255,255,0.4)">/</li>
          <li><a href={`/services/${service.slug}/`} class="hover:text-white transition-colors">{service.name}</a></li>
          <li style="color:rgba(255,255,255,0.4)">/</li>
          <li style="color:rgba(255,255,255,0.85)">{location.name}</li>
        </ol>
      </nav>
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full mb-4 font-heading" style="background:#C41C1C; color:white">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          {location.name}, {location.county} County, GA
        </div>
        <h1 class="font-bold text-white mb-5 font-heading" style="font-size:clamp(2rem,5vw,3.25rem); line-height:1.15">
          {service.name} in {location.name}, <span style="color:#F87171">Georgia</span>
        </h1>
        <p class="text-lg mb-8 font-body" style="color:rgba(255,255,255,0.82); max-width:580px; line-height:1.7">
          {combo ? combo.uniqueIntro : `Licensed and insured ${service.name.toLowerCase()} serving ${location.name} and all of ${location.county} County. Free on-site estimates.`}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact/" class="bg-primary-600 hover:bg-primary-700 text-white px-7 py-3.5 rounded-lg font-semibold font-heading transition-all shadow-lg hover:-translate-y-0.5">
            Free estimate
          </a>
          <a href={`tel:${site.phone}`} class="border-2 border-white text-white px-7 py-3.5 rounded-lg font-semibold font-heading flex items-center gap-2 transition-all hover:bg-white hover:text-neutral-900">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {site.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Local Challenges -->
  {combo && combo.localProblems.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="font-bold mb-8 font-heading" style="font-size:1.75rem; color:#1A1A1A">
          Common {service.name.toLowerCase()} challenges in {location.name}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {combo.localProblems.map((problem) => (
            <div class="flex items-start gap-3 p-5 rounded-xl font-body" style="background:#F5F3EF">
              <div class="w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background:#FEF2F2">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </div>
              <p style="color:#374151; font-size:0.9rem; line-height:1.6">{problem}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Sub-services for this category in this city -->
  <section class="py-16" style="background:#F5F3EF">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="font-bold mb-8 font-heading" style="font-size:1.75rem; color:#1A1A1A">
        Our {service.name.toLowerCase()} services in {location.name}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.subServices.slice(0, 6).map((sub) => (
          <a href={`/services/${service.slug}/${sub.slug}/`} class="bg-white rounded-xl p-6 transition-all hover:-translate-y-1 shadow-card group font-body">
            <h3 class="font-semibold mb-2 group-hover:text-primary-700 font-heading" style="color:#1A1A1A">{sub.name}</h3>
            <p style="color:#6B7280; font-size:0.875rem; line-height:1.6">{sub.description.slice(0, 100)}…</p>
            <span class="text-sm font-semibold mt-4 flex items-center gap-1 font-heading" style="color:#C41C1C">
              Learn more
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  {combo && combo.uniqueFaqs.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="font-bold mb-8 font-heading" style="font-size:1.75rem; color:#1A1A1A">
          {service.name} in {location.name} — frequently asked questions
        </h2>
        <div class="space-y-4">
          {combo.uniqueFaqs.map((faq) => (
            <details class="rounded-xl border border-neutral-100 p-6 font-body">
              <summary class="font-semibold cursor-pointer font-heading" style="color:#1A1A1A">{faq.question}</summary>
              <p class="mt-3" style="color:#6B7280; line-height:1.7">{faq.answer}</p>
            </details>
          ))}
        </div>
        {combo.localTip && (
          <div class="mt-8 p-5 rounded-xl flex gap-4" style="background:#FEF2F2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
            <p class="text-sm font-body" style="color:#7A1010"><strong class="font-heading">Local tip:</strong> {combo.localTip}</p>
          </div>
        )}
      </div>
    </section>
  )}

  <CTASection />

  <Footer slot="footer" />
</BaseLayout>
