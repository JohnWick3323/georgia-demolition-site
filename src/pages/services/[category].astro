---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import ContactForm from '../../components/ContactForm.astro';
import { mainServices, type MainService } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return mainServices.map(ms => ({
    params: { category: ms.slug },
    props: { service: ms }
  }));
}

interface Props {
  service: MainService;
}

const { service } = Astro.props;

const breadcrumbs = [
  { name: "Services", url: "/services/" },
  { name: service.name, url: `/services/${service.slug}/` }
];

// Service schema
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "description": service.description,
  "provider": { "@id": `${site.url}/#organization` },
  "areaServed": { "@type": "State", "name": "Georgia" }
};
---

<BaseLayout
  title={`${service.name} in Georgia | ${site.name}`}
  description={service.metaDescription}
  image={service.image}
  breadcrumbs={breadcrumbs}
  schemaOverride={JSON.stringify(serviceSchema)}
>
  <Header slot="header" />

  <!-- Hero with real image -->
  <section class="relative text-white" role="img" aria-label={`${service.name} services in Georgia`} style={`background:linear-gradient(rgba(0,0,0,0.70),rgba(0,0,0,0.60)), url('${service.image || "/images/hero-services.webp"}') center/cover no-repeat; padding-top:128px; padding-bottom:80px`}>
    <div class="max-w-7xl mx-auto px-6">
      <!-- Breadcrumb -->
      <nav class="mb-6">
        <ol class="flex items-center gap-2 text-xs flex-wrap" style="color:rgba(255,255,255,0.65)">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li style="color:rgba(255,255,255,0.4)">/</li>
          <li><a href="/services/" class="hover:text-white transition-colors">Services</a></li>
          <li style="color:rgba(255,255,255,0.4)">/</li>
          <li style="color:rgba(255,255,255,0.85)">{service.name}</li>
        </ol>
      </nav>

      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-full mb-4 font-heading" style="background:#C41C1C; color:white">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          Georgia Demolition Services
        </div>
        <h1 class="font-bold text-white mb-5 font-heading" style="font-size:clamp(2.2rem,5vw,3.5rem); line-height:1.15">
          {service.heroHeading}
        </h1>
        <p class="text-lg mb-8 font-body" style="color:rgba(255,255,255,0.82); max-width:600px; line-height:1.7">
          {service.description}
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact/" class="bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-semibold font-heading transition-all shadow-lg hover:-translate-y-0.5">
            Free estimate
          </a>
          <a href={`tel:${site.phone}`} class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold font-heading flex items-center gap-2 transition-all hover:bg-white hover:text-neutral-900">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            {site.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Sub-services Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 text-sm font-semibold px-4 py-1.5 rounded-full mb-4 font-heading" style="background:#FEF2F2; color:#C41C1C">
          {service.subServices.length} specialized services
        </div>
        <h2 class="font-bold mb-4 font-heading" style="font-size:2.2rem; color:#1A1A1A">
          {service.name} <span style="color:#C41C1C">services we offer</span>
        </h2>
        <p class="text-lg font-body" style="color:#6B7280; max-width:600px; margin:0 auto">Complete range of {service.name.toLowerCase()} services across all 159 Georgia counties</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.subServices.map(sub => (
          <a href={`/services/${service.slug}/`} class="group bg-white rounded-xl p-6 transition-all hover:-translate-y-1 hover:shadow-red" style="box-shadow:0 2px 12px rgba(0,0,0,0.07); border:1px solid #F3F4F6">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background:#FEF2F2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2H2v2z"/><path d="M20 15V9a8 8 0 1 0-16 0v6"/><path d="M4 15h16"/></svg>
            </div>
            <h3 class="font-semibold mb-3 transition-colors group-hover:text-primary-700 font-heading" style="font-size:1.05rem; color:#1A1A1A">
              {sub.name}
            </h3>
            <p class="text-sm leading-relaxed mb-4 font-body" style="color:#6B7280">
              {sub.description.length > 110 ? sub.description.slice(0, 110) + '…' : sub.description}
            </p>
            <span class="text-sm font-semibold flex items-center gap-1.5 font-heading" style="color:#C41C1C">
              Learn more
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why choose for this category -->
  <section class="py-20" style="background:#F5F3EF">
    <div class="max-w-5xl mx-auto px-6">
      <div class="bg-white rounded-2xl p-10" style="box-shadow:0 2px 16px rgba(0,0,0,0.07)">
        <h2 class="font-bold mb-8 font-heading" style="font-size:2rem; color:#1A1A1A">
          Why choose us for <span style="color:#C41C1C">{service.name.toLowerCase()}?</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {[
            `Licensed and insured for all ${service.name.toLowerCase()} work in Georgia`,
            "Serving all 159 Georgia counties with fast crew mobilization",
            "Pre-demolition hazardous material surveys and abatement coordination",
            "Complete permit handling with all Georgia county building departments",
            "Georgia EPD compliant waste disposal and documentation",
            "Free on-site estimates with detailed scope breakdown"
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background:#C41C1C">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>
              </div>
              <span class="text-sm leading-relaxed font-body" style="color:#4B5563">{item}</span>
            </div>
          ))}
        </div>
        <div class="mt-8 pt-8" style="border-top:1px solid #E5E7EB">
          <a href="/contact/" class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-semibold font-heading transition-all shadow-red">
            Get a free estimate for {service.name.toLowerCase()}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- GHL Contact Form -->
  <section class="py-20" style="background:#F5F3EF">
    <div class="max-w-3xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="font-bold mb-3 font-heading" style="font-size:2rem;color:#1A1A1A">
          Get a Free <span style="color:#C41C1C">{service.name}</span> Estimate
        </h2>
        <p class="font-body" style="color:#6B7280">Serving all 159 Georgia counties. We respond within 1 business day.</p>
      </div>
      <ContactForm
        title={`Free ${service.name} Estimate`}
        subtitle="Tell us about your project and we'll get back to you within 1 business day."
      />
    </div>
  </section>

  <CTASection />
  <Footer slot="footer" />
</BaseLayout>
