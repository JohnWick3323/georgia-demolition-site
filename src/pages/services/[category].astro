---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import { mainServices, type MainService } from '../../data/services';

export function getStaticPaths() {
  return mainServices.map(ms => ({
    params: { category: ms.slug },
    props: { service: ms }
  }));
}

interface Props {
  service: MainService;
}

const { service } = Astro.props;
---

<BaseLayout
  title={`${service.name} in Georgia | Expert Demolition Services`}
  description={service.metaDescription}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="relative text-white pt-32 pb-20" style="background:linear-gradient(135deg, #1A0505 0%, #3D0808 60%, #560A0A 100%)">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-1.5 rounded-full mb-5" style="background:rgba(196,28,28,0.4); color:#FCA5A5; font-family:'Outfit',sans-serif">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Georgia Demolition Services
      </div>
      <h1 class="font-bold text-white mb-6 max-w-4xl mx-auto" style="font-family:'Outfit',sans-serif; font-size:clamp(2.2rem,5vw,3.5rem); line-height:1.15">
        {service.heroHeading}
      </h1>
      <p class="text-lg max-w-3xl mx-auto mb-10" style="color:rgba(255,255,255,0.8); font-family:'Inter',sans-serif">
        {service.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="font-bold px-8 py-4 rounded-lg text-lg transition-all hover:-translate-y-0.5 shadow-lg" style="background:#C41C1C; color:white; font-family:'Outfit',sans-serif">
          Get Free Estimate
        </a>
        <a href="tel:(843) 241-0787" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg text-lg transition-all hover:-translate-y-0.5" style="font-family:'Outfit',sans-serif">
          (843) 241-0787
        </a>
      </div>
    </div>
  </section>

  <!-- Sub-services Grid -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:2.2rem; color:#1A1A1A">
          {service.name} <span style="color:#C41C1C">Services</span>
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.subServices.map(sub => (
          <a href={`/services/${service.slug}/${sub.slug}/`} class="group bg-white rounded-xl p-6 transition-all hover:-translate-y-1" style="box-shadow:0 2px 12px rgba(0,0,0,0.07); border:1px solid #F3F4F6">
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background:#FEF2F2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <h3 class="font-semibold mb-3 transition-colors group-hover:text-red-700" style="font-family:'Outfit',sans-serif; font-size:1.05rem; color:#1A1A1A">
              {sub.name}
            </h3>
            <p class="text-sm leading-relaxed mb-4" style="color:#6B7280; font-family:'Inter',sans-serif">
              {sub.description.length > 110 ? sub.description.slice(0, 110) + '…' : sub.description}
            </p>
            <span class="text-sm font-semibold flex items-center gap-1.5" style="color:#C41C1C; font-family:'Outfit',sans-serif">
              Learn More →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why choose for this category -->
  <section class="py-20" style="background:#F9F9F9">
    <div class="max-w-5xl mx-auto px-6">
      <div class="bg-white rounded-2xl p-10" style="box-shadow:0 2px 16px rgba(0,0,0,0.07)">
        <h2 class="font-bold mb-8" style="font-family:'Outfit',sans-serif; font-size:2rem; color:#1A1A1A">
          Why Choose Us for <span style="color:#C41C1C">{service.name}?</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {[
            "Licensed and insured for all Georgia demolition work",
            "Serving all 159 Georgia counties with fast mobilization",
            "Pre-demolition hazardous material surveys and abatement",
            "Complete permit handling with all Georgia county building departments",
            "Georgia EPD compliant disposal and documentation",
            "Free on-site estimates with no obligation"
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5" style="background:#C41C1C">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>
              </div>
              <span class="text-sm leading-relaxed" style="color:#4B5563; font-family:'Inter',sans-serif">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection />
  <Footer slot="footer" />
</BaseLayout>
