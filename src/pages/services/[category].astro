---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import { mainServices, type MainService } from '../../data/services';

export function getStaticPaths() {
  return mainServices.map(ms => ({
    params: { category: ms.slug },
    props: { service: ms }
  }));
}

interface Props {
  service: MainService;
}

const { service } = Astro.props;
---

<BaseLayout
  title={`${service.name} in Georgia | Expert Demolition Services`}
  description={service.metaDescription}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-neutral-900 text-white pt-32 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-primary-900 opacity-50"></div>
    <div class="relative z-10 container mx-auto px-4 max-w-7xl text-center">
      <div class="text-primary-400 font-heading text-sm uppercase tracking-widest mb-3">Georgia Demolition Services</div>
      <h1 class="text-5xl md:text-6xl font-bold uppercase tracking-wide mb-6">{service.heroHeading}</h1>
      <p class="text-lg text-neutral-300 max-w-3xl mx-auto mb-8" style="text-transform:none;font-family:var(--font-body);">
        {service.description}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="bg-primary-600 hover:bg-primary-700 text-white font-bold px-8 py-4 rounded font-heading uppercase tracking-wide transition-all">Get Free Quote</a>
        <a href="tel:(843) 241-0787" class="bg-white bg-opacity-10 border border-white border-opacity-30 text-white font-bold px-8 py-4 rounded font-heading uppercase tracking-wide transition-all">(843) 241-0787</a>
      </div>
    </div>
  </section>

  <!-- Sub-services Grid -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-7xl">
      <h2 class="text-3xl font-bold uppercase tracking-wide text-center mb-10">
        {service.name} Services
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {service.subServices.map(sub => (
          <a href={`/services/${service.slug}/${sub.slug}/`} class="group bg-neutral-50 hover:bg-primary-600 rounded-xl p-6 border border-neutral-200 hover:border-primary-600 transition-all hover:-translate-y-1 hover:shadow-red">
            <h3 class="font-heading font-bold text-lg uppercase tracking-wide mb-3 text-neutral-900 group-hover:text-white transition-colors">{sub.name}</h3>
            <p class="text-sm text-neutral-600 group-hover:text-primary-100 leading-relaxed mb-4 transition-colors" style="text-transform:none;font-family:var(--font-body);">{sub.description}</p>
            <span class="text-primary-600 group-hover:text-white text-sm font-semibold font-heading uppercase tracking-wide transition-colors">Learn More →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why choose for this category -->
  <section class="py-16 bg-neutral-50">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-neutral-100">
        <h2 class="text-3xl font-bold uppercase tracking-wide mb-6">Why Choose Us for {service.name}?</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {[
            "Licensed and insured for all Georgia demolition work",
            "Serving all 159 Georgia counties with fast mobilization",
            "Pre-demolition hazardous material surveys and abatement",
            "Complete permit handling with all Georgia county building departments",
            "Georgia EPD compliant disposal and documentation",
            "Free on-site estimates with no obligation"
          ].map(item => (
            <div class="flex items-start gap-3">
              <div class="w-6 h-6 bg-primary-600 rounded-full flex items-center justify-center shrink-0 mt-0.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>
              </div>
              <span class="text-sm text-neutral-700 leading-relaxed" style="text-transform:none;font-family:var(--font-body);">{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTASection heading={`Ready to Start Your ${service.name} Project?`} />
  <Footer slot="footer" />
</BaseLayout>
