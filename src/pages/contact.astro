---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Contact Georgia Demolition & Removal | Free Estimate"
  description="Contact Georgia Demolition & Removal for a free demolition estimate. Call (843) 241-0787 or submit our online form. Serving all 159 Georgia counties."
>
  <Header slot="header" />

  <section class="bg-neutral-900 text-white pt-32 pb-16">
    <div class="container mx-auto px-4 max-w-7xl text-center">
      <h1 class="text-5xl font-bold uppercase tracking-wide mb-4">Get a Free Demolition Estimate</h1>
      <p class="text-xl text-neutral-300 max-w-2xl mx-auto" style="text-transform:none;font-family:var(--font-body);">
        Licensed, insured, and serving all 159 Georgia counties. Contact us today for your free on-site estimate.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Form -->
        <div>
          <h2 class="text-3xl font-bold uppercase tracking-wide mb-6">Request Your Free Estimate</h2>
          <form action="#" method="POST" class="space-y-5">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label for="fname" class="block text-sm font-heading font-bold uppercase tracking-wide text-neutral-700 mb-2">First Name *</label>
                <input type="text" id="fname" name="fname" required class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-900" style="text-transform:none;font-family:var(--font-body);" />
              </div>
              <div>
                <label for="lname" class="block text-sm font-heading font-bold uppercase tracking-wide text-neutral-700 mb-2">Last Name *</label>
                <input type="text" id="lname" name="lname" required class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-900" style="text-transform:none;font-family:var(--font-body);" />
              </div>
            </div>
            <div>
              <label for="email" class="block text-sm font-heading font-bold uppercase tracking-wide text-neutral-700 mb-2">Email Address *</label>
              <input type="email" id="email" name="email" required class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-900" style="text-transform:none;font-family:var(--font-body);" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-heading font-bold uppercase tracking-wide text-neutral-700 mb-2">Phone Number *</label>
              <input type="tel" id="phone" name="phone" required class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-900" style="text-transform:none;font-family:var(--font-body);" />
            </div>
            <div>
              <label for="city" class="block text-sm font-heading font-bold uppercase tracking-wide text-neutral-700 mb-2">City, GA</label>
              <input type="text" id="city" name="city" placeholder="Your city in Georgia" class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-900" style="text-transform:none;font-family:var(--font-body);" />
            </div>
            <div>
              <label for="service" class="block text-sm font-heading font-bold uppercase tracking-wide text-neutral-700 mb-2">Service Needed</label>
              <select id="service" name="service" class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-900 bg-white" style="text-transform:none;font-family:var(--font-body);">
                <option value="">Select a service...</option>
                <option value="residential">Residential Demolition</option>
                <option value="commercial">Commercial Demolition</option>
                <option value="home">Full Home Demolition</option>
                <option value="pool">Pool Removal</option>
                <option value="garage">Garage Demolition</option>
                <option value="deck">Deck Removal</option>
                <option value="concrete">Concrete Removal</option>
                <option value="mobile">Mobile Home Removal</option>
                <option value="site">Site Clearing</option>
                <option value="asbestos">Asbestos Abatement</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-heading font-bold uppercase tracking-wide text-neutral-700 mb-2">Project Details</label>
              <textarea id="message" name="message" rows="4" placeholder="Tell us about your demolition project — size, location, timeline, and any special requirements..." class="w-full px-4 py-3 border border-neutral-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500 text-neutral-900 resize-none" style="text-transform:none;font-family:var(--font-body);"></textarea>
            </div>
            <button type="submit" class="w-full bg-primary-600 hover:bg-primary-700 text-white font-bold py-4 rounded font-heading uppercase tracking-wide text-lg transition-all shadow-red">
              Request Free Estimate
            </button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="space-y-8">
          <div>
            <h2 class="text-3xl font-bold uppercase tracking-wide mb-6">Contact Information</h2>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold uppercase tracking-wide text-sm mb-1">Phone</h3>
                  <a href={`tel:${site.phone}`} class="text-primary-600 font-semibold text-xl hover:text-primary-700" style="text-transform:none;font-family:var(--font-body);">{site.phone}</a>
                  <p class="text-sm text-neutral-500 mt-1" style="text-transform:none;font-family:var(--font-body);">Available for emergency calls</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold uppercase tracking-wide text-sm mb-1">Email</h3>
                  <a href={`mailto:${site.email}`} class="text-primary-600 hover:text-primary-700" style="text-transform:none;font-family:var(--font-body);">{site.email}</a>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/></svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold uppercase tracking-wide text-sm mb-1">Service Area</h3>
                  <p class="text-neutral-700" style="text-transform:none;font-family:var(--font-body);">All 159 Georgia Counties</p>
                  <p class="text-sm text-neutral-500" style="text-transform:none;font-family:var(--font-body);">Statewide coverage from the Blue Ridge Mountains to the coast</p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-neutral-50 rounded-xl p-6 border border-neutral-200">
            <h3 class="font-heading font-bold uppercase tracking-wide mb-4">What to Expect</h3>
            <ol class="space-y-3">
              {["Submit your request or call us directly","We contact you within 1 business day to schedule your estimate","Our team visits your Georgia property for a free on-site assessment","You receive a detailed written estimate with no obligation","We handle all permits, utilities, and regulatory requirements","Your project is completed on time and on budget"].map((step, i) => (
                <li class="flex items-start gap-3 text-sm text-neutral-700" style="text-transform:none;font-family:var(--font-body);">
                  <span class="w-6 h-6 bg-primary-600 rounded-full text-white text-xs font-bold flex items-center justify-center shrink-0 font-heading">{i+1}</span>
                  {step}
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Google Maps Section -->
  <section class="py-12 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-6 font-heading" style="color:#1A1A1A">Our Georgia Service Area</h2>
      <div class="rounded-2xl overflow-hidden shadow-lg" style="height:420px">
        <iframe
          width="100%"
          height="100%"
          style="border:0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src={`https://www.google.com/maps/embed/v1/place?key=${site.googleMapsEmbedKey}&q=Georgia,USA&zoom=7`}
        ></iframe>
      </div>
      <p class="text-sm text-neutral-500 mt-3 font-body">We serve all 159 Georgia counties — from the Blue Ridge Mountains to the Golden Isles coast.</p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
