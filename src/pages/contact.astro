---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';

const breadcrumbs = [
  { name: 'Contact', url: '/contact/' }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": site.url + "/contact/" }
  ]
};
---

<BaseLayout
  title="Get a Free Demolition Estimate | Contact Us Today"
  description="Request your free demolition estimate from Georgia's licensed contractors. Call (843) 241-0787 or submit our form. Fast response, all 159 counties served."
  breadcrumbs={breadcrumbs}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <Header slot="header" />

  <!-- Hero -->
  <section class="relative text-white pt-32 pb-16" role="img" aria-label="Contact Georgia Demolition and Removal for a free estimate" style="background:linear-gradient(rgba(0,0,0,0.75),rgba(0,0,0,0.75)),url('/images/hero-contact.webp') center/cover no-repeat; background-color:#1a0a0a">
    <div class="container mx-auto px-4 max-w-7xl text-center">
      <nav class="flex justify-center mb-6">
        <ol class="flex items-center gap-2 text-xs" style="color:rgba(255,255,255,0.65)">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li style="color:rgba(255,255,255,0.4)">/</li>
          <li style="color:rgba(255,255,255,0.9)">Contact</li>
        </ol>
      </nav>
      <h1 class="text-5xl font-bold uppercase tracking-wide mb-4">Get a Free Demolition Estimate</h1>
      <p class="text-xl text-neutral-300 max-w-2xl mx-auto" style="text-transform:none;font-family:var(--font-body);">
        Licensed, insured, and serving all 159 Georgia counties. Contact us today for your free on-site estimate.
      </p>
    </div>
  </section>

  <!-- Form + Contact Info -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

        <!-- GHL Form -->
        <div>
          <ContactForm
            title="Request Your Free Estimate"
            subtitle="We respond within 1 business day. Serving all 159 Georgia counties."
          />
        </div>

        <!-- Contact Info -->
        <div class="space-y-8">
          <div>
            <h2 class="text-3xl font-bold uppercase tracking-wide mb-6">Contact Information</h2>
            <div class="space-y-4">
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold uppercase tracking-wide text-sm mb-1">Phone</h3>
                  <a href={`tel:${site.phone}`} class="text-primary-600 font-semibold text-xl hover:text-primary-700" style="text-transform:none;font-family:var(--font-body);">{site.phone}</a>
                  <p class="text-sm text-neutral-500 mt-1" style="text-transform:none;font-family:var(--font-body);">Available for emergency calls</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold uppercase tracking-wide text-sm mb-1">Email</h3>
                  <a href={`mailto:${site.email}`} class="text-primary-600 hover:text-primary-700" style="text-transform:none;font-family:var(--font-body);">{site.email}</a>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 bg-primary-600 rounded-lg flex items-center justify-center shrink-0">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/></svg>
                </div>
                <div>
                  <h3 class="font-heading font-bold uppercase tracking-wide text-sm mb-1">Service Area</h3>
                  <p class="text-neutral-700" style="text-transform:none;font-family:var(--font-body);">All 159 Georgia Counties</p>
                  <p class="text-sm text-neutral-500" style="text-transform:none;font-family:var(--font-body);">Statewide coverage from the Blue Ridge Mountains to the coast</p>
                </div>
              </div>
            </div>
          </div>

          <div class="bg-neutral-50 rounded-xl p-6 border border-neutral-200">
            <h3 class="font-heading font-bold uppercase tracking-wide mb-4">What to Expect</h3>
            <ol class="space-y-3">
              {[
                "Submit your request or call us directly",
                "We contact you within 1 business day to schedule your estimate",
                "Our team visits your Georgia property for a free on-site assessment",
                "You receive a detailed written estimate with no obligation",
                "We handle all permits, utilities, and regulatory requirements",
                "Your project is completed on time and on budget"
              ].map((step, i) => (
                <li class="flex items-start gap-3 text-sm text-neutral-700" style="text-transform:none;font-family:var(--font-body);">
                  <span class="w-6 h-6 bg-primary-600 rounded-full text-white text-xs font-bold flex items-center justify-center shrink-0 font-heading">{i+1}</span>
                  {step}
                </li>
              ))}
            </ol>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Google Maps Section -->
  <section class="py-12 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-6 font-heading" style="color:#1A1A1A">Our Georgia Service Area</h2>
      <div class="rounded-2xl overflow-hidden shadow-lg" style="height:420px">
        <iframe
          width="100%"
          height="100%"
          style="border:0"
          loading="lazy"
          allowfullscreen
          referrerpolicy="no-referrer-when-downgrade"
          src={`https://www.google.com/maps/embed/v1/place?key=${site.googleMapsEmbedKey}&q=Georgia,USA&zoom=7`}
        ></iframe>
      </div>
      <p class="text-sm text-neutral-500 mt-3 font-body">We serve all 159 Georgia counties — from the Blue Ridge Mountains to the Golden Isles coast.</p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
