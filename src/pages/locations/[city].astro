---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import { locations, type Location } from '../../data/locations';
import { mainServices } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return locations.map(loc => ({
    params: { city: loc.slug },
    props: { location: loc }
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
const mapsKey = site.googleMapsKey;
---

<BaseLayout
  title={`Demolition Services in ${location.name}, GA | ${location.county} County`}
  description={location.metaDescription}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="bg-neutral-900 text-white pt-32 pb-16">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="max-w-3xl">
        <div class="text-primary-400 font-heading text-sm uppercase tracking-widest mb-3">
          Georgia Demolition Services · {location.county} County
        </div>
        <h1 class="text-5xl font-bold uppercase tracking-wide mb-4">
          Demolition Services in {location.name}, GA
        </h1>
        <p class="text-lg text-neutral-300 mb-8" style="text-transform:none;font-family:var(--font-body);">
          {location.localInsight}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact/" class="bg-primary-600 hover:bg-primary-700 text-white font-bold px-8 py-4 rounded font-heading uppercase tracking-wide transition-all">Get Free Quote</a>
          <a href={`tel:${site.phone}`} class="bg-white bg-opacity-10 border border-white border-opacity-30 text-white font-bold px-8 py-4 rounded font-heading uppercase tracking-wide hover:bg-opacity-20 transition-all">{site.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content + Map -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-10">
          <!-- Local Info -->
          <div>
            <h2 class="text-3xl font-bold uppercase tracking-wide mb-4">Demolition Services in {location.name}</h2>
            <p class="text-neutral-700 leading-relaxed mb-4" style="text-transform:none;font-family:var(--font-body);">
              Georgia Demolition Experts provides complete demolition and removal services in {location.name} and throughout {location.county} County. Whether you need a residential structure torn down, commercial property cleared, or specialty demolition work, our licensed and insured crews are ready to serve your {location.name} property.
            </p>
            <p class="text-neutral-700 leading-relaxed" style="text-transform:none;font-family:var(--font-body);">
              We are familiar with {location.county} County's building departments, permitting requirements, and local regulations. Our team handles the entire process from permits to final site grading, ensuring your {location.name} demolition project is completed on time, on budget, and in full compliance with Georgia regulations.
            </p>
          </div>

          <!-- Services in this City -->
          <div>
            <h2 class="text-3xl font-bold uppercase tracking-wide mb-6">Services We Offer in {location.name}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {mainServices.map(cat => (
                <div class="p-4 rounded-lg border border-neutral-200 hover:border-primary-500 hover:bg-primary-50 transition-all">
                  <h3 class="font-heading font-bold text-sm uppercase tracking-wide text-neutral-900 mb-2">{cat.name}</h3>
                  <ul class="space-y-1">
                    {cat.subServices.slice(0, 4).map(sub => (
                      <li>
                        <a href={`/services/${cat.slug}/${sub.slug}/`} class="text-xs text-primary-600 hover:text-primary-700 transition-colors" style="text-transform:none;font-family:var(--font-body);">
                          → {sub.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <!-- Landmarks -->
          {location.landmarks.length > 0 && (
            <div>
              <h2 class="text-2xl font-bold uppercase tracking-wide mb-4">About {location.name}, GA</h2>
              <p class="text-neutral-700 mb-4" style="text-transform:none;font-family:var(--font-body);">
                {location.name} is located in {location.county} County, Georgia. Notable landmarks and points of reference in the area include:
              </p>
              <ul class="grid grid-cols-2 gap-2">
                {location.landmarks.map(lm => (
                  <li class="flex items-center gap-2 text-sm text-neutral-600" style="text-transform:none;font-family:var(--font-body);">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600 shrink-0"><path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"/></svg>
                    {lm}
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- CTA -->
          <div class="bg-primary-600 text-white rounded-xl p-6">
            <h3 class="font-heading font-bold text-xl uppercase tracking-wide mb-3">Free Estimate in {location.name}</h3>
            <p class="text-primary-100 text-sm mb-4" style="text-transform:none;font-family:var(--font-body);">Licensed & insured demolition in {location.county} County, Georgia.</p>
            <div class="space-y-3">
              <a href="/contact/" class="block bg-white text-primary-700 font-bold py-3 rounded text-center font-heading uppercase tracking-wide text-sm hover:bg-gray-100 transition-colors">Request Quote</a>
              <a href={`tel:${site.phone}`} class="block bg-primary-800 text-white font-bold py-3 rounded text-center font-heading uppercase tracking-wide text-sm hover:bg-primary-900 transition-colors border border-primary-500">{site.phone}</a>
            </div>
          </div>

          <!-- Why Us -->
          <div class="bg-white rounded-xl p-6 border border-neutral-200">
            <h3 class="font-heading font-bold text-base uppercase tracking-wide mb-4">Why Choose Us in {location.name}</h3>
            <ul class="space-y-2">
              {[`Licensed in ${location.county} County`,`Fast mobilization to ${location.name}`,`Familiar with local regulations`,"Free on-site estimates","Georgia EPD compliant","Fully insured"].map(item => (
                <li class="flex items-center gap-2 text-sm text-neutral-700" style="text-transform:none;font-family:var(--font-body);">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-primary-600 shrink-0"><path d="m20 6-11 11-5-5"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Map -->
          <div class="rounded-xl overflow-hidden border border-neutral-200">
            <iframe
              width="100%"
              height="250"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              src={`https://www.google.com/maps/embed/v1/place?key=${mapsKey}&q=${encodeURIComponent(location.name + ', ' + location.county + ' County, Georgia')}`}
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection heading={`Ready for Demolition in ${location.name}?`} subtext={`Licensed and insured demolition services in ${location.name}, ${location.county} County, Georgia. Get your free on-site estimate today.`} />
  <Footer slot="footer" />
</BaseLayout>
