---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';
import { locations, type Location } from '../../data/locations';
import { mainServices } from '../../data/services';
import { site } from '../../data/site';

export function getStaticPaths() {
  return locations.map(loc => ({
    params: { city: loc.slug },
    props: { location: loc }
  }));
}

interface Props {
  location: Location;
}

const { location } = Astro.props;
---

<BaseLayout
  title={`Demolition Services in ${location.name}, GA | ${location.county} County`}
  description={location.metaDescription}
>
  <Header slot="header" />

  <!-- Hero -->
  <section class="text-white pt-32 pb-20" style="background:linear-gradient(135deg, #1A0505 0%, #3D0808 60%, #560A0A 100%)">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-3xl">
        <div class="text-sm font-semibold mb-3" style="color:#FCA5A5; font-family:'Outfit',sans-serif">
          Georgia Demolition Services · {location.county} County
        </div>
        <h1 class="font-bold text-white mb-5" style="font-family:'Outfit',sans-serif; font-size:clamp(2rem,5vw,3.2rem); line-height:1.15">
          Demolition Services in {location.name}, GA
        </h1>
        <p class="text-lg mb-10" style="color:rgba(255,255,255,0.8); font-family:'Inter',sans-serif">
          {location.localInsight}
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/contact/" class="font-bold px-8 py-4 rounded-lg transition-all hover:-translate-y-0.5 shadow-lg" style="background:#C41C1C; color:white; font-family:'Outfit',sans-serif">
            Get Free Estimate
          </a>
          <a href={`tel:${site.phone}`} class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg transition-all hover:-translate-y-0.5" style="font-family:'Outfit',sans-serif">
            {site.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content + Map -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Main Content -->
        <div class="lg:col-span-2 space-y-10">
          <!-- Local Info -->
          <div>
            <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:1.8rem; color:#1A1A1A">
              Demolition Services in {location.name}
            </h2>
            <p class="leading-relaxed mb-4" style="color:#4B5563; font-family:'Inter',sans-serif">
              Georgia Demolition Experts provides complete demolition and removal services in {location.name} and throughout {location.county} County. Whether you need a residential structure torn down, commercial property cleared, or specialty demolition work, our licensed and insured crews are ready to serve your {location.name} property.
            </p>
            <p class="leading-relaxed" style="color:#4B5563; font-family:'Inter',sans-serif">
              We are familiar with {location.county} County's building departments, permitting requirements, and local regulations. Our team handles the entire process from permits to final site grading, ensuring your {location.name} demolition project is completed on time, on budget, and in full compliance with Georgia regulations.
            </p>
          </div>

          <!-- Services in this City -->
          <div>
            <h2 class="font-bold mb-6" style="font-family:'Outfit',sans-serif; font-size:1.8rem; color:#1A1A1A">
              Services We Offer in {location.name}
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {mainServices.map(cat => (
                <div class="p-5 rounded-xl transition-all" style="border:1px solid #E5E7EB; background:white">
                  <h3 class="font-semibold text-sm mb-3" style="color:#1A1A1A; font-family:'Outfit',sans-serif">{cat.name}</h3>
                  <ul class="space-y-1.5">
                    {cat.subServices.slice(0, 4).map(sub => (
                      <li>
                        <a href={`/services/${cat.slug}/${sub.slug}/`} class="text-xs transition-colors hover:text-red-700" style="color:#C41C1C; font-family:'Inter',sans-serif">
                          → {sub.name}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>

          <!-- Local Details -->
          {location.landmarks.length > 0 && (
            <div>
              <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:1.5rem; color:#1A1A1A">
                Local Landmarks Near Our {location.name} Projects
              </h2>
              <div class="flex flex-wrap gap-2">
                {location.landmarks.map(lm => (
                  <span class="px-3 py-1.5 text-sm rounded-full" style="background:#FEF2F2; color:#C41C1C; font-family:'Inter',sans-serif">
                    {lm}
                  </span>
                ))}
              </div>
            </div>
          )}

          {location.neighborhoods.length > 0 && (
            <div>
              <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:1.5rem; color:#1A1A1A">
                Neighborhoods We Serve in {location.name}
              </h2>
              <div class="flex flex-wrap gap-2">
                {location.neighborhoods.map(n => (
                  <span class="px-3 py-1.5 text-sm rounded-full" style="background:#F9FAFB; color:#4B5563; border:1px solid #E5E7EB; font-family:'Inter',sans-serif">
                    {n}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="space-y-6">
          <!-- CTA Card -->
          <div class="rounded-xl p-6 text-white" style="background:#C41C1C">
            <h3 class="font-bold mb-2" style="font-family:'Outfit',sans-serif; font-size:1.1rem">
              Free Estimate in {location.name}
            </h3>
            <p class="text-sm mb-4" style="color:rgba(255,255,255,0.85); font-family:'Inter',sans-serif">
              Licensed &amp; insured demolition contractors serving {location.county} County. No obligation.
            </p>
            <a href="/contact/" class="block bg-white font-bold py-3 rounded-lg text-center text-sm mb-3 transition-colors hover:bg-neutral-100" style="color:#C41C1C; font-family:'Outfit',sans-serif">
              Get Free Estimate
            </a>
            <a href={`tel:${site.phone}`} class="block text-white font-bold py-3 rounded-lg text-center text-sm border border-white/30 hover:bg-white/10 transition-colors" style="font-family:'Outfit',sans-serif">
              {site.phone}
            </a>
          </div>

          <!-- Why Us -->
          <div class="rounded-xl p-6" style="background:#F9F9F9; border:1px solid #E5E7EB">
            <h3 class="font-semibold mb-4 text-sm" style="font-family:'Outfit',sans-serif; color:#1A1A1A">
              Why {location.name} Chooses Us
            </h3>
            <ul class="space-y-3">
              {[
                `Licensed in ${location.county} County`,
                "Fully insured (GL + Workers Comp)",
                "Free on-site estimates",
                "Georgia EPD compliant",
                "Fast mobilization statewide",
                "Permit handling included"
              ].map(item => (
                <li class="flex items-center gap-2 text-sm" style="color:#4B5563; font-family:'Inter',sans-serif">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="m20 6-11 11-5-5"/></svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Map -->
          <div class="rounded-xl overflow-hidden" style="border:1px solid #E5E7EB; aspect-ratio:4/3">
            <iframe
              width="100%"
              height="100%"
              style="border:0"
              loading="lazy"
              allowfullscreen
              src={`https://www.google.com/maps/embed/v1/place?key=${site.googleMapsKey}&q=${encodeURIComponent(location.name + ', ' + location.county + ' County, Georgia')}&zoom=12`}
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTASection heading={`Ready for Demolition in ${location.name}?`} subtext={`Licensed, insured, and serving all of ${location.county} County, Georgia. Free estimates.`} />
  <Footer slot="footer" />
</BaseLayout>
