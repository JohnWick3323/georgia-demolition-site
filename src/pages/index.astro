---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.tsx';
import ContactForm from '../components/ContactForm.astro';
import { mainServices } from '../data/services';
import { locations } from '../data/locations';
import { site } from '../data/site';

const featuredCities = locations.slice(0, 12);

const homepageFaqs = [
  { question: "Do you serve all 159 Georgia counties?", answer: "Yes. Georgia Demolition & Removal provides demolition and removal services across all 159 Georgia counties, from Rabun County in the northeast mountains to Camden County on the Florida border. We have equipment strategically positioned across the state for fast mobilization." },
  { question: "Are you licensed and insured for demolition work in Georgia?", answer: "Yes. We are fully licensed and insured for demolition work in Georgia, carrying general liability insurance, pollution liability coverage, and workers compensation insurance. We maintain all required Georgia state licenses for demolition contracting." },
  { question: "How much does demolition cost in Georgia?", answer: "Demolition costs in Georgia vary widely depending on the structure type, size, construction materials, hazardous materials present, and site conditions. Residential structure demolitions typically range from $5,000 to $25,000. We provide free on-site estimates for all projects." },
  { question: "Do I need a permit for demolition in Georgia?", answer: "Most demolition projects in Georgia require permits from the county building department. We handle the permit process for you, including required notifications to Georgia EPD for asbestos, utility disconnections, and any other regulatory requirements." },
  { question: "How do you handle asbestos before demolition?", answer: "We conduct or coordinate licensed asbestos surveys for all structures built before 1981, as required by Georgia EPD and federal NESHAP regulations. If asbestos is found, we coordinate licensed abatement before demolition begins." },
  { question: "What equipment do you use for demolition in Georgia?", answer: "Our Georgia fleet includes hydraulic excavators, bulldozers, skid steers, concrete crushers, jackhammers, and dust suppression systems. We match equipment to each project for maximum efficiency and minimal site impact." },
  { question: "Can you handle partial or interior demolitions?", answer: "Yes. We specialize in selective demolition for renovations, remodels, and interior strip-outs. Our crews use precision tools to remove specific sections while protecting surrounding structures." },
  { question: "How do you protect the environment during demolition?", answer: "We use dust suppression systems, concrete recycling at Georgia-certified facilities, and proper hazardous material disposal per Georgia EPD regulations. All recyclable materials are sorted and diverted from landfills." },
  { question: "How long does a demolition project take in Georgia?", answer: "Most residential demolitions take 1–3 days for the actual teardown. With permitting and utility coordination, the full timeline is typically 2–4 weeks. Larger commercial projects may take several weeks." },
  { question: "What factors affect the cost of demolition in Georgia?", answer: "Key factors include structure size, construction type, hazardous materials (asbestos, lead), site access, disposal requirements, and permit complexity. We provide transparent pricing after a free on-site assessment." }
];

const testimonials = [
  { name: "Mike T.", location: "Atlanta, GA", text: "Georgia Demolition & Removal took down our old garage in one day, cleaned everything up perfectly, and the price was very fair. Highly recommend for any demolition work in Atlanta." },
  { name: "Sandra W.", location: "Savannah, GA", text: "We had an old pool that needed removing. They handled the permit, showed up on time, and did excellent work. The backfill looks perfect. Professional crew from start to finish." },
  { name: "James R.", location: "Augusta, GA", text: "Used them for a full home demolition in Augusta. They handled the asbestos testing, utility disconnections, permits—everything. Site was cleared and graded in less than a week. Outstanding service." }
];

const homeBreadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{ "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" }]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": homepageFaqs.map(faq => ({
    "@type": "Question", "name": faq.question, "acceptedAnswer": { "@type": "Answer", "text": faq.answer }
  }))
};
---

<BaseLayout
  title="Georgia Demolition & Removal | Licensed Demo Contractors"
  description="Licensed, insured demolition contractors serving all 159 Georgia counties since 2010. Residential, commercial & industrial demolition with free estimates."
>
  <script type="application/ld+json" set:html={JSON.stringify(homeBreadcrumbs)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <Header slot="header" />

  <!-- SECTION 1 — HERO -->
  <section class="relative min-h-screen flex items-center" aria-label="Georgia Demolition and Removal — safe, fast, and reliable demolition across Georgia" style="background: linear-gradient(to right, rgba(0,0,0,0.84) 0%, rgba(0,0,0,0.55) 55%, rgba(0,0,0,0.25) 100%), url('/images/hero-home.webp') center/cover no-repeat; background-color:#1a0a0a;">
    <div class="absolute top-24 left-6 md:left-16 text-white text-xs font-semibold px-4 py-2 rounded-full flex items-center gap-2 font-heading bg-primary-800/90 backdrop-blur-sm">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
      FULLY LICENSED &amp; INSURED GEORGIA EXPERTS
    </div>
    <div class="max-w-7xl mx-auto px-6 md:px-16 py-32 w-full">
      <div class="max-w-2xl">
        <h1 class="text-white leading-tight mb-6 font-heading font-bold" style="font-size:clamp(2.8rem,6vw,4.5rem); line-height:1.1">
          Expert Demolition &amp; Removal <span class="text-primary-400">Across All of Georgia</span>
        </h1>
        <p class="text-xl mb-10 leading-relaxed max-w-xl font-body" style="color:rgba(255,255,255,0.82)">
          From residential teardowns to commercial demolition, we provide safe, licensed, and efficient services across all 159 Georgia counties.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact/" class="bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all shadow-xl hover:-translate-y-1 font-heading">
            Get a Free Estimate
          </a>
          <a href={`tel:${site.phone}`} class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all flex items-center gap-3 font-heading hover:bg-white hover:text-neutral-900">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.13 11.8 19.79 19.79 0 0 1 1.06 3.18 2 2 0 0 1 3.03 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16.92z"/></svg>
            {site.phone}
          </a>
        </div>
        <div class="flex flex-wrap gap-8 mt-12 pt-8 border-t border-white/20">
          <div><div class="text-primary-400 font-heading font-bold text-2xl">500+</div><div class="text-sm mt-0.5 font-body" style="color:rgba(255,255,255,0.65)">Projects Done</div></div>
          <div><div class="text-primary-400 font-heading font-bold text-2xl">159</div><div class="text-sm mt-0.5 font-body" style="color:rgba(255,255,255,0.65)">GA Counties</div></div>
          <div><div class="text-primary-400 font-heading font-bold text-2xl">24/7</div><div class="text-sm mt-0.5 font-body" style="color:rgba(255,255,255,0.65)">Emergency</div></div>
          <div><div class="text-primary-400 font-heading font-bold text-2xl">100%</div><div class="text-sm mt-0.5 font-body" style="color:rgba(255,255,255,0.65)">Guarantee</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES STRIP -->
  <div class="text-white py-[18px]" style="background:#1A0505">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-12 text-sm font-semibold font-heading">
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          Licensed &amp; Insured
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 3 21 3s-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.1z"/></svg>
          All 159 GA Counties
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          24/7 Emergency Response
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Free Estimates
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>
          500+ Projects Completed
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 2 — SERVICES -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 text-sm font-semibold px-4 py-1.5 rounded-full mb-4 font-heading bg-primary-50 text-primary-600">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2H2v2z"/><path d="M20 15V9a8 8 0 1 0-16 0v6"/><path d="M4 15h16"/></svg>
          Comprehensive Demolition Services
        </div>
        <h2 class="font-bold mb-4 font-heading text-neutral-900" style="font-size:2.5rem; line-height:1.2">
          Expert Demolition Solutions <span class="text-primary-600">for Georgia</span>
        </h2>
        <p class="text-lg max-w-2xl mx-auto font-body text-neutral-500">
          Complete demolition and removal services for residential, commercial, and industrial properties throughout all 159 Georgia counties.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {mainServices.map((service) => (
          <a href={`/services/${service.slug}/`} class="group bg-white rounded-xl overflow-hidden transition-all hover:-translate-y-1 border border-neutral-100 shadow-card">
            {service.image && (
              <div class="overflow-hidden h-[180px]">
                <img src={service.image} alt={service.name} class="w-full h-full object-cover transition-transform group-hover:scale-105" loading="lazy" />
              </div>
            )}
            <div class="p-7">
              <h3 class="font-semibold mb-3 transition-colors group-hover:text-primary-700 font-heading text-neutral-900" style="font-size:1.15rem">{service.name}</h3>
              <p class="text-sm leading-relaxed mb-4 font-body text-neutral-500">
                {service.description.length > 120 ? service.description.slice(0, 120) + '…' : service.description}
              </p>
              <span class="text-sm font-semibold flex items-center gap-1.5 font-heading text-primary-600">
                Learn more
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/services/" class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3 rounded-lg border-2 transition-all hover:-translate-y-0.5 font-heading border-primary-600 text-primary-600">
          View All Services
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 3 — WHY CHOOSE US -->
  <section class="py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="font-bold mb-4 font-heading text-neutral-900" style="font-size:2.5rem">
          Why Georgia Homeowners <span class="text-primary-600">Choose Us</span>
        </h2>
        <p class="text-lg max-w-xl mx-auto font-body text-neutral-500">
          Georgia's most trusted demolition specialists — licensed, insured, and ready to serve.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { num: "01", title: "Licensed & Insured", desc: "Fully licensed Georgia demolition contractors with complete liability and workers' comp coverage on every job." },
          { num: "02", title: "Free Estimates", desc: "No-obligation on-site estimates across all 159 Georgia counties. Get your quote within 24 hours." },
          { num: "03", title: "All 159 Counties", desc: "We mobilize to every corner of Georgia, from Atlanta metro to the coast and mountains." },
          { num: "04", title: "Same-Week Start", desc: "Most projects begin within the same week of estimate approval. Emergency demolition available 24/7." }
        ].map(item => (
          <div class="bg-white rounded-xl p-7 relative overflow-hidden transition-all hover:-translate-y-1 shadow-card">
            <div class="absolute top-4 right-5 text-primary-200 font-heading font-bold select-none" style="font-size:3.5rem; line-height:1">{item.num}</div>
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4 bg-primary-50">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>
            </div>
            <h3 class="font-semibold mb-2.5 font-heading text-neutral-900" style="font-size:1.1rem">{item.title}</h3>
            <p class="text-sm leading-relaxed font-body text-neutral-500">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3B — DISCOVER OUR PROCESS (7-step) -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold uppercase tracking-widest mb-3 font-heading text-primary-600">Our Proven Process</p>
        <h2 class="font-bold font-heading text-neutral-900" style="font-size:clamp(1.75rem,4vw,2.5rem)">Discover How Georgia Demolition & Removal Works</h2>
        <p class="mt-4 max-w-2xl mx-auto font-body text-neutral-500">A transparent, structured demolition process — from initial assessment to final cleanup. Every step built around safety, compliance, and efficiency for Georgia property owners.</p>
      </div>

      <div class="space-y-10 max-w-3xl mx-auto">
        {[
          {
            num: "01", title: "Initial Assessment & Consultation",
            desc: "We begin with a thorough on-site assessment of your Georgia property. Our team evaluates the structure, surrounding areas, soil conditions, and potential challenges. We discuss your goals, answer questions, and provide a detailed written project outline and estimate — all with no obligation.",
            icon: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>'
          },
          {
            num: "02", title: "Permitting & Legal Requirements",
            desc: "We handle every permit, inspection, and regulatory filing required by your Georgia county. From building department demolition permits to Georgia EPD asbestos notifications and utility disconnection coordination — we manage the entire compliance process so you don't have to.",
            icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>'
          },
          {
            num: "03", title: "Safety Protocols & Risk Management",
            desc: "Safety is our top priority. Before any work begins, we develop a site-specific safety plan, conduct risk assessments, and hold crew safety briefings. A dedicated safety officer oversees every Georgia project to ensure full compliance with OSHA and state regulations.",
            icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>'
          },
          {
            num: "04", title: "Site Preparation & Equipment Setup",
            desc: "Once permits and safety plans are in place, we prepare the site. Our team coordinates utility disconnections with Georgia Power, Atlanta Gas Light, and local water departments. We position hydraulic excavators, skid steers, and support equipment for maximum efficiency and safe access.",
            icon: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 3 21 3s-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.1z"/>'
          },
          {
            num: "05", title: "Demolition Execution",
            desc: "Our licensed crews execute the demolition systematically using the right equipment for each phase. From roof removal to foundation breaking, we work methodically. Hazardous materials identified during assessment are handled by licensed abatement contractors before the main demolition proceeds.",
            icon: '<rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/>'
          },
          {
            num: "06", title: "Debris Hauling & Waste Disposal",
            desc: "After demolition, we clear the site of all debris. Concrete is transported to Georgia-certified recycling facilities. Metals are sorted for scrap recycling. Wood, drywall, and non-recyclable materials go to permitted Georgia C&D landfills. We follow Georgia EPD waste management guidelines throughout.",
            icon: '<polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>'
          },
          {
            num: "07", title: "Final Grading & Site Handover",
            desc: "We complete every project with proper backfill, compaction, and final grading to Georgia building standards. Erosion control measures are installed where required. You receive a clean, graded site ready for new construction, landscaping, or sale — with all disposal documentation provided.",
            icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>'
          }
        ].map(item => (
          <div class="flex flex-col md:flex-row gap-6 items-start bg-neutral-50 rounded-2xl p-8 shadow-card">
            <div class="shrink-0 w-16 h-16 rounded-full flex items-center justify-center bg-primary-50">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon}></svg>
            </div>
            <div>
              <div class="flex items-center gap-3 mb-2">
                <span class="text-2xl font-black font-heading text-primary-100">{item.num}</span>
                <h3 class="font-bold text-lg font-heading text-neutral-900">{item.title}</h3>
              </div>
              <p class="text-sm leading-relaxed font-body text-neutral-600">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/contact/" class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-lg font-semibold transition-all hover:-translate-y-0.5 shadow-lg font-heading">
          Start With a Free Estimate
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 3C — EQUIPMENT & CAPABILITIES -->
  <section class="py-20 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="font-bold mb-4 font-heading text-neutral-900" style="font-size:2.5rem">
          Equipment <span class="text-primary-600">We Use</span>
        </h2>
        <p class="text-lg max-w-2xl mx-auto font-body text-neutral-500">The right equipment makes all the difference in delivering safe, efficient, and eco-friendly demolition. Our Georgia fleet handles projects of every scale — from residential teardowns to large commercial demolitions.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- State-of-the-Art Machinery -->
        <div class="bg-white rounded-2xl p-8 shadow-card">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-5 bg-primary-50">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 3 21 3s-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.1z"/></svg>
          </div>
          <h3 class="font-bold text-lg mb-4 font-heading text-neutral-900">State-of-the-Art Machinery</h3>
          <p class="text-sm leading-relaxed mb-4 font-body text-neutral-500">Our heavy-duty equipment is built for large-scale structures across Georgia's diverse terrain — from urban Atlanta infill lots to rural farm demolitions.</p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 text-sm font-body text-neutral-600">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="m9 18 6-6-6-6"/></svg>
              Hydraulic excavators for precise dismantling
            </li>
            <li class="flex items-start gap-2 text-sm font-body text-neutral-600">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="m9 18 6-6-6-6"/></svg>
              Bulldozers for rapid site clearing and grading
            </li>
            <li class="flex items-start gap-2 text-sm font-body text-neutral-600">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5"><path d="m9 18 6-6-6-6"/></svg>
              Loaders and skid steers for debris transport
            </li>
