---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.tsx';
import ContactForm from '../components/ContactForm.astro';
import { mainServices } from '../data/services';
import { locations } from '../data/locations';
import { site } from '../data/site';

const featuredCities = locations.slice(0, 12);

const serviceIcons: Record<string, string> = {
  'residential-demolition': '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>',
  'post-demolition': '<polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>',
  'core-demolition': '<rect width="16" height="20" x="4" y="2" rx="2" ry="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01"/><path d="M16 6h.01"/><path d="M12 6h.01"/>',
  'specialized-demolition': '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>',
  'ancillary-demolition': '<path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"/><path d="M7 7h.01"/>',
};

const homepageFaqs = [
  { question: "Do you serve all 159 Georgia counties?", answer: "Yes. Georgia Demolition & Removal provides demolition and removal services across all 159 Georgia counties, from Rabun County in the northeast mountains to Camden County on the Florida border. We have equipment strategically positioned across the state for fast mobilization." },
  { question: "Are you licensed and insured for demolition work in Georgia?", answer: "Yes. We are fully licensed and insured for demolition work in Georgia, carrying general liability insurance, pollution liability coverage, and workers compensation insurance. We maintain all required Georgia state licenses for demolition contracting." },
  { question: "How much does demolition cost in Georgia?", answer: "Demolition costs in Georgia vary widely depending on the structure type, size, construction materials, hazardous materials present, and site conditions. Residential structure demolitions typically range from $5,000 to $25,000. We provide free on-site estimates for all projects." },
  { question: "Do I need a permit for demolition in Georgia?", answer: "Most demolition projects in Georgia require permits from the county building department. We handle the permit process for you, including required notifications to Georgia EPD for asbestos, utility disconnections, and any other regulatory requirements." },
  { question: "How do you handle asbestos before demolition?", answer: "We conduct or coordinate licensed asbestos surveys for all structures built before 1981, as required by Georgia EPD and federal NESHAP regulations. If asbestos is found, we coordinate licensed abatement before demolition begins." }
];

const testimonials = [
  { name: "Mike T.", location: "Atlanta, GA", text: "Georgia Demolition & Removal took down our old garage in one day, cleaned everything up perfectly, and the price was very fair. Highly recommend for any demolition work in Atlanta." },
  { name: "Sandra W.", location: "Savannah, GA", text: "We had an old pool that needed removing. They handled the permit, showed up on time, and did excellent work. The backfill looks perfect. Professional crew from start to finish." },
  { name: "James R.", location: "Augusta, GA", text: "Used them for a full home demolition in Augusta. They handled the asbestos testing, utility disconnections, permits—everything. Site was cleared and graded in less than a week. Outstanding service." }
];
---

<BaseLayout
  title="Georgia Demolition & Removal | Licensed Demolition Services Statewide"
  description="Georgia's most trusted demolition and removal specialists. Licensed & insured for residential, commercial, and industrial demolition across all 159 Georgia counties. Free estimates."
>
  <Header slot="header" />

  <!-- SECTION 1 — HERO -->
  <section class="relative min-h-screen flex items-center" style="background: linear-gradient(to right, rgba(0,0,0,0.84) 0%, rgba(0,0,0,0.55) 55%, rgba(0,0,0,0.25) 100%), url('/images/hero-home.webp') center/cover no-repeat; background-color:#1a0a0a;">
    <div class="absolute top-24 left-6 md:left-16 text-white text-xs font-semibold px-4 py-2 rounded-full flex items-center gap-2" style="background:rgba(122,16,16,0.92); backdrop-filter:blur(8px); font-family:'Outfit',sans-serif">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
      FULLY LICENSED &amp; INSURED GEORGIA EXPERTS
    </div>

    <div class="max-w-7xl mx-auto px-6 md:px-16 py-32 w-full">
      <div class="max-w-2xl">
        <h1 class="font-bold text-white leading-tight mb-6" style="font-family:'Outfit',sans-serif; font-size:clamp(2.8rem,6vw,4.5rem); line-height:1.1">
          Expert Demolition & Removal <span style="color:#F87171">Across All of Georgia</span>
        </h1>
        <p class="text-xl mb-10 leading-relaxed max-w-xl" style="color:rgba(255,255,255,0.82); font-family:'Inter',sans-serif">
          From residential teardowns to commercial demolition, we provide safe, licensed, and efficient services across all 159 Georgia counties.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/contact/" class="text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all shadow-xl hover:-translate-y-1" style="background:#C41C1C; font-family:'Outfit',sans-serif">
            Get a Free Estimate
          </a>
          <a href={`tel:${site.phone}`} class="border-2 border-white text-white px-8 py-4 rounded-lg font-semibold text-lg transition-all flex items-center gap-3" style="font-family:'Outfit',sans-serif" onmouseover="this.style.color='#1A1A1A';this.style.background='white'" onmouseout="this.style.color='white';this.style.background='transparent'">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.13 11.8 19.79 19.79 0 0 1 1.06 3.18 2 2 0 0 1 3.03 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16.92z"/></svg>
            {site.phone}
          </a>
        </div>
        <div class="flex flex-wrap gap-8 mt-12 pt-8" style="border-top:1px solid rgba(255,255,255,0.2)">
          <div><div class="font-bold text-2xl" style="color:#F87171; font-family:'Outfit',sans-serif">500+</div><div class="text-sm mt-0.5" style="color:rgba(255,255,255,0.65); font-family:'Inter',sans-serif">Projects Done</div></div>
          <div><div class="font-bold text-2xl" style="color:#F87171; font-family:'Outfit',sans-serif">159</div><div class="text-sm mt-0.5" style="color:rgba(255,255,255,0.65); font-family:'Inter',sans-serif">GA Counties</div></div>
          <div><div class="font-bold text-2xl" style="color:#F87171; font-family:'Outfit',sans-serif">24/7</div><div class="text-sm mt-0.5" style="color:rgba(255,255,255,0.65); font-family:'Inter',sans-serif">Emergency</div></div>
          <div><div class="font-bold text-2xl" style="color:#F87171; font-family:'Outfit',sans-serif">100%</div><div class="text-sm mt-0.5" style="color:rgba(255,255,255,0.65); font-family:'Inter',sans-serif">Licensed</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES STRIP -->
  <div style="background:#1A0505; color:white; padding:18px 0">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-12 text-sm font-semibold font-heading">
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          Licensed &amp; Insured
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21 3 21 3s-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.1z"/></svg>
          All 159 GA Counties
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          24/7 Emergency Response
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          Free Estimates
        </div>
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/></svg>
          500+ Projects Completed
        </div>
      </div>
    </div>
  </div>

  <!-- SECTION 2 — SERVICES -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <div class="inline-flex items-center gap-2 text-sm font-semibold px-4 py-1.5 rounded-full mb-4" style="background:#FEF2F2; color:#C41C1C; font-family:'Outfit',sans-serif">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2H2v2z"/><path d="M20 15V9a8 8 0 1 0-16 0v6"/><path d="M4 15h16"/></svg>
          Professional Demolition Services
        </div>
        <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:2.5rem; color:#1A1A1A; line-height:1.2">
          Expert Demolition Solutions <span style="color:#C41C1C">for Georgia</span>
        </h2>
        <p class="text-lg max-w-2xl mx-auto" style="color:#6B7280; font-family:'Inter',sans-serif">
          Complete demolition and removal services for residential, commercial, and industrial properties throughout all 159 Georgia counties.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {mainServices.map((service) => (
          <a href={`/services/${service.slug}/`} class="group bg-white rounded-xl overflow-hidden transition-all hover:-translate-y-1" style="box-shadow:0 2px 12px rgba(0,0,0,0.07); border:1px solid #F3F4F6">
            {service.image && (
              <div class="overflow-hidden" style="height:180px">
                <img src={service.image} alt={service.name} class="w-full h-full object-cover transition-transform group-hover:scale-105" loading="lazy" />
              </div>
            )}
            <div class="p-7">
              <h3 class="font-semibold mb-3 transition-colors group-hover:text-primary-700 font-heading" style="font-size:1.15rem; color:#1A1A1A">
                {service.name}
              </h3>
              <p class="text-sm leading-relaxed mb-4 font-body" style="color:#6B7280">
                {service.description.length > 120 ? service.description.slice(0, 120) + '…' : service.description}
              </p>
              <span class="text-sm font-semibold flex items-center gap-1.5 font-heading" style="color:#C41C1C">
                Learn more
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/services/" class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3 rounded-lg border-2 transition-all hover:-translate-y-0.5" style="border-color:#C41C1C; color:#C41C1C; font-family:'Outfit',sans-serif">
          View All Services
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 3 — WHY CHOOSE US -->
  <section class="py-20" style="background:#F9F9F9">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:2.5rem; color:#1A1A1A">
          Why Georgia Homeowners <span style="color:#C41C1C">Choose Us</span>
        </h2>
        <p class="text-lg max-w-xl mx-auto" style="color:#6B7280; font-family:'Inter',sans-serif">
          Georgia's most trusted demolition specialists — licensed, insured, and ready to serve.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {[
          { num: "01", title: "Licensed & Insured", desc: "Fully licensed Georgia demolition contractors with complete liability and workers' comp coverage on every job." },
          { num: "02", title: "Free Estimates", desc: "No-obligation on-site estimates across all 159 Georgia counties. Get your quote within 24 hours." },
          { num: "03", title: "All 159 Counties", desc: "We mobilize to every corner of Georgia, from Atlanta metro to the coast and mountains." },
          { num: "04", title: "Same-Week Start", desc: "Most projects begin within the same week of estimate approval. Emergency demolition available 24/7." }
        ].map(item => (
          <div class="bg-white rounded-xl p-7 relative overflow-hidden transition-all hover:-translate-y-1" style="box-shadow:0 2px 12px rgba(0,0,0,0.06)">
            <div class="absolute top-4 right-5 font-bold select-none" style="font-size:3.5rem; color:#FEE2E2; font-family:'Outfit',sans-serif; line-height:1">{item.num}</div>
            <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-4" style="background:#FEF2F2">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m20 6-11 11-5-5"/></svg>
            </div>
            <h3 class="font-semibold mb-2.5" style="font-family:'Outfit',sans-serif; font-size:1.1rem; color:#1A1A1A">{item.title}</h3>
            <p class="text-sm leading-relaxed" style="color:#6B7280; font-family:'Inter',sans-serif">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 3B — HOW OUR PROCESS WORKS -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <p class="text-sm font-semibold uppercase tracking-widest mb-3" style="color:#C41C1C; font-family:'Outfit',sans-serif">Our Proven Process</p>
        <h2 class="font-bold" style="font-size:clamp(1.75rem,4vw,2.5rem); color:#1A1A1A; font-family:'Outfit',sans-serif">How Georgia Demolition & Removal Works</h2>
        <p class="mt-4 max-w-2xl mx-auto" style="color:#6B7280; font-family:'Inter',sans-serif">From your first call to a clean, cleared site — our streamlined process keeps your project on time and on budget.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 relative">
        <!-- Connector line (desktop) -->
        <div class="hidden md:block absolute top-10 left-1/3 right-1/3 h-0.5" style="background:linear-gradient(to right,#C41C1C,#C41C1C); opacity:0.2; z-index:0"></div>
        {[
          {
            step: "01",
            title: "Free On-Site Estimate",
            desc: "Call us or submit a request. We visit your Georgia property within 1–2 business days, assess the scope, handle permit research, and give you a detailed written estimate — no obligation.",
            icon: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>'
          },
          {
            step: "02",
            title: "Permits & Utility Coordination",
            desc: "We handle every permit, inspection, and utility disconnection required by your Georgia county. EPD asbestos notifications, building department filings — all done for you.",
            icon: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>'
          },
          {
            step: "03",
            title: "Safe Demolition & Site Cleanup",
            desc: "Our licensed crews execute the demolition safely and efficiently. All debris is hauled to certified Georgia disposal facilities. Site is graded, backfilled, and left clean.",
            icon: '<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>'
          }
        ].map((item, i) => (
          <div class="relative bg-white rounded-2xl p-8 text-center" style="box-shadow:0 2px 20px rgba(0,0,0,0.08); z-index:1">
            <div class="w-16 h-16 rounded-full mx-auto mb-5 flex items-center justify-center" style="background:#FEF2F2">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon}></svg>
            </div>
            <div class="text-4xl font-black mb-3" style="color:#F5F3EF; font-family:'Outfit',sans-serif; line-height:1">{item.step}</div>
            <h3 class="font-bold text-lg mb-3" style="color:#1A1A1A; font-family:'Outfit',sans-serif">{item.title}</h3>
            <p class="text-sm leading-relaxed" style="color:#6B7280; font-family:'Inter',sans-serif">{item.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/contact/" class="inline-flex items-center gap-2 text-white px-8 py-4 rounded-lg font-semibold transition-all hover:-translate-y-0.5 shadow-lg" style="background:#C41C1C; font-family:'Outfit',sans-serif">
          Start With a Free Estimate
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 4 — DARK RED CTA -->
  <section class="py-20" style="background:#7A1010">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-1.5 rounded-full mb-6" style="background:rgba(255,255,255,0.15); color:white; font-family:'Outfit',sans-serif">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
        Emergency Demolition Available
      </div>
      <h2 class="font-bold text-white mb-5" style="font-family:'Outfit',sans-serif; font-size:2.4rem; line-height:1.2">
        Need Emergency Demolition?
      </h2>
      <p class="text-lg mb-10 max-w-2xl mx-auto" style="color:rgba(255,255,255,0.82); font-family:'Inter',sans-serif">
        Storm damage, fire damage, structural collapse — our licensed crews are available 24/7 across all of Georgia. Call now for immediate response.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`tel:${site.phone}`} class="bg-white font-bold px-8 py-4 rounded-lg text-lg transition-all hover:bg-neutral-100 hover:-translate-y-0.5 shadow-lg" style="color:#C41C1C; font-family:'Outfit',sans-serif">
          Call Now — {site.phone}
        </a>
        <a href="/contact/" class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg text-lg transition-all hover:-translate-y-0.5" style="font-family:'Outfit',sans-serif">
          Get Free Estimate
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 5 — GEORGIA COVERAGE -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:2.5rem; color:#1A1A1A">
          Serving All of <span style="color:#C41C1C">Georgia</span>
        </h2>
        <p class="text-lg max-w-xl mx-auto" style="color:#6B7280; font-family:'Inter',sans-serif">
          From Atlanta to Savannah, Augusta to Columbus — we serve all 159 Georgia counties.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 mb-10">
        {featuredCities.map(city => (
          <a href={`/locations/${city.slug}/`} class="group flex items-center gap-2 px-4 py-3 rounded-lg border transition-all hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50" style="border-color:#E5E7EB; font-family:'Inter',sans-serif">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#C41C1C" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="text-sm font-medium group-hover:text-red-700 transition-colors" style="color:#374151">{city.name}</span>
          </a>
        ))}
      </div>

      <div class="text-center">
        <a href="/locations/" class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3 rounded-lg transition-all hover:-translate-y-0.5" style="background:#FEF2F2; color:#C41C1C; font-family:'Outfit',sans-serif">
          View All Locations
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 6 — TESTIMONIALS -->
  <section class="py-20" style="background:#F9F9F9">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-bold mb-4" style="font-family:'Outfit',sans-serif; font-size:2.5rem; color:#1A1A1A">
          What Georgia Customers <span style="color:#C41C1C">Are Saying</span>
        </h2>
        <p class="text-lg" style="color:#6B7280; font-family:'Inter',sans-serif">Real reviews from real Georgia demolition projects</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {testimonials.map(t => (
          <div class="bg-white rounded-xl p-7 transition-all hover:-translate-y-1" style="box-shadow:0 2px 12px rgba(0,0,0,0.07)">
            <div class="font-bold mb-4 leading-none select-none" style="font-size:3rem; color:#FEE2E2; font-family:Georgia,serif; line-height:1">&ldquo;</div>
            <div class="flex gap-1 mb-4">
              {[1,2,3,4,5].map(() => (
                <svg width="16" height="16" viewBox="0 0 24 24" fill="#C41C1C" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
            <p class="text-sm leading-relaxed mb-6" style="color:#4B5563; font-family:'Inter',sans-serif">"{t.text}"</p>
            <div class="flex items-center gap-3 pt-4" style="border-top:1px solid #F3F4F6">
              <div class="w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm text-white" style="background:#C41C1C; font-family:'Outfit',sans-serif">
                {t.name.charAt(0)}
              </div>
              <div>
                <div class="font-semibold text-sm" style="color:#1A1A1A; font-family:'Outfit',sans-serif">{t.name}</div>
                <div class="text-xs" style="color:#9CA3AF; font-family:'Inter',sans-serif">{t.location}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SECTION 7 — FAQs -->
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center mb-12">
        <h2 class="font-bold mb-4 font-heading" style="font-size:2.5rem; color:#1A1A1A">
          Frequently asked <span style="color:#C41C1C">questions</span>
        </h2>
        <p class="text-lg font-body" style="color:#6B7280">Everything you need to know about Georgia demolition</p>
      </div>
      <FAQAccordion faqs={homepageFaqs} client:load />
    </div>
  </section>

  <!-- CONTACT FORM SECTION -->
  <section class="py-20" style="background:#F5F3EF">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-12">
        <div class="inline-flex items-center gap-2 text-sm font-semibold px-4 py-1.5 rounded-full mb-4 font-heading" style="background:#FEF2F2; color:#C41C1C">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Free estimate — no obligation
        </div>
        <h2 class="font-bold mb-4 font-heading" style="font-size:2.5rem; color:#1A1A1A">
          Get your <span style="color:#C41C1C">free demolition estimate</span>
        </h2>
        <p class="text-lg font-body" style="color:#6B7280">Tell us about your project and we'll respond within 2 hours</p>
      </div>
      <ContactForm />
    </div>
  </section>

  <!-- LOCAL EXPERTS SECTION -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="font-bold mb-4 font-heading" style="font-size:2.5rem; color:#1A1A1A">
          Serving all of <span style="color:#C41C1C">Georgia</span>
        </h2>
        <p class="text-lg max-w-2xl mx-auto font-body" style="color:#6B7280">From the Blue Ridge Mountains to the Golden Isles — licensed demolition crews in every Georgia county</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 mb-10">
        {featuredCities.map(city => (
          <a href={`/locations/${city.slug}/`} class="text-center p-3 rounded-lg border border-neutral-100 hover:border-primary-200 hover:bg-primary-50 transition-all group font-body" style="font-size:0.85rem">
            <div class="font-semibold group-hover:text-primary-700 transition-colors" style="color:#1A1A1A">{city.name}</div>
            <div style="color:#9CA3AF; font-size:0.75rem">{city.county} Co.</div>
          </a>
        ))}
      </div>
      <div class="text-center">
        <a href="/locations/" class="inline-flex items-center gap-2 font-semibold text-sm px-6 py-3 rounded-lg border-2 transition-all hover:-translate-y-0.5 font-heading" style="border-color:#C41C1C; color:#C41C1C">
          View all 159 Georgia counties
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 8 — FINAL CTA -->
  <section class="py-20" style="background:#C41C1C">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="font-bold text-white mb-5" style="font-family:'Outfit',sans-serif; font-size:2.4rem; line-height:1.2">
        Ready to Start Your Georgia Demolition Project?
      </h2>
      <p class="text-lg mb-10 max-w-2xl mx-auto" style="color:rgba(255,255,255,0.85); font-family:'Inter',sans-serif">
        Licensed, insured &amp; serving all 159 Georgia counties. Get your free on-site estimate today — no obligation.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact/" class="bg-white font-bold px-8 py-4 rounded-lg text-lg transition-all hover:bg-neutral-100 hover:-translate-y-0.5 shadow-lg" style="color:#C41C1C; font-family:'Outfit',sans-serif">
          Get Free Estimate
        </a>
        <a href={`tel:${site.phone}`} class="border-2 border-white text-white font-bold px-8 py-4 rounded-lg text-lg transition-all hover:-translate-y-0.5 flex items-center justify-center gap-2" style="font-family:'Outfit',sans-serif">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.13 11.8 19.79 19.79 0 0 1 1.06 3.18 2 2 0 0 1 3.03 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21 16.92z"/></svg>
          {site.phone}
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
