---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import FAQAccordion from '../components/FAQAccordion.tsx';

const allFaqs = [
  { question: "Do you serve all 159 Georgia counties?", answer: "Yes. Georgia Demolition Experts provides demolition and removal services across all 159 Georgia counties. We have equipment and crews positioned strategically across the state for fast mobilization anywhere in Georgia." },
  { question: "Are you licensed and insured for demolition in Georgia?", answer: "Yes. We are fully licensed and insured for demolition contracting in Georgia, carrying general liability insurance, pollution liability coverage, and workers compensation insurance on all projects." },
  { question: "How much does home demolition cost in Georgia?", answer: "Residential home demolition in Georgia typically costs $8,000–$25,000 depending on the home's size, construction type, presence of hazardous materials, and site conditions. We provide free on-site estimates." },
  { question: "Do you handle asbestos before demolition in Georgia?", answer: "Yes. We conduct or coordinate licensed asbestos surveys for all pre-1981 structures as required by Georgia EPD and federal NESHAP. If asbestos is found, we arrange licensed abatement before demolition begins. Georgia EPD requires a minimum 10 working days notification before demolition of asbestos-containing structures." },
  { question: "Do I need a permit for demolition in Georgia?", answer: "Most demolition projects in Georgia require permits from the local county building department. We handle the complete permit process including all applications, utility notifications, and required inspections as part of our service." },
  { question: "How long does it take to demolish a house in Georgia?", answer: "The actual demolition of a single-family home typically takes 1–3 days. However, the full process from contract to cleared lot—including permit acquisition, utility disconnections, and hazardous material testing—typically takes 2–4 weeks." },
  { question: "What happens to the debris after demolition?", answer: "We sort and recycle demolition materials to the maximum extent possible. Concrete goes to Georgia-certified concrete recycling facilities, metal to scrap recyclers, and clean wood to chipping or biomass facilities. All waste is disposed of at licensed Georgia solid waste facilities." },
  { question: "Can you remove just part of a structure in Georgia?", answer: "Yes. We offer selective demolition services where we remove specific building elements—walls, floors, additions—while preserving the rest of the structure. This is common for renovation projects across Georgia." },
  { question: "Do you demolish commercial buildings in Georgia?", answer: "Yes. We demolish commercial buildings of all types including retail, office, warehouse, and industrial facilities across all 159 Georgia counties. Our commercial demolition services include pre-demolition surveys, utility disconnection, permit handling, and complete debris removal." },
  { question: "How do I get a free estimate for demolition in Georgia?", answer: "Call us at (843) 241-0787 or submit our online contact form. We'll schedule a free on-site visit to assess your Georgia project and provide a detailed written estimate with no obligation." },
  { question: "Can you remove an old pool in Georgia?", answer: "Yes. We offer both full pool removal (complete excavation and removal of the shell) and pool fill-in demolition (breaking the upper structure and filling the shell). Both options are available across Georgia with permit handling included." },
  { question: "Do you handle mobile home removal in Georgia?", answer: "Yes. We remove single-wide and double-wide mobile homes and manufactured homes across Georgia. We handle utility disconnections, septic capping coordination, hazardous material testing, and complete debris removal." },
  { question: "What environmental regulations apply to demolition in Georgia?", answer: "Key Georgia regulations include the Georgia EPD NESHAP asbestos notification requirements, Georgia Erosion and Sedimentation Act requirements for land disturbance, Georgia Solid Waste Management Act requirements for debris disposal, and air quality regulations governing demolition dust. We are fully current on all applicable regulations." },
  { question: "Do you recycle demolition materials in Georgia?", answer: "Yes. Recycling is built into our standard operations. We typically achieve 75–95% diversion from landfills on Georgia demolition projects through concrete crushing, metal recycling, wood chipping, and asphalt recycling at Georgia-certified facilities." },
  { question: "Can you demolish a building in a Georgia historic district?", answer: "Yes, with appropriate approvals. Demolition in Georgia historic districts requires review by the local historic preservation commission before permits are issued. We coordinate with preservation authorities and the Georgia State Historic Preservation Office (SHPO) as needed for projects in historic areas." }
];
---

<BaseLayout
  title="Demolition FAQs | Georgia Demolition Experts"
  description="Frequently asked questions about demolition services in Georgia. Learn about costs, permits, asbestos requirements, and more from Georgia's trusted demolition experts."
>
  <Header slot="header" />

  <section class="bg-neutral-900 text-white pt-32 pb-16">
    <div class="container mx-auto px-4 max-w-7xl text-center">
      <h1 class="text-5xl font-bold uppercase tracking-wide mb-4">Demolition FAQs</h1>
      <p class="text-xl text-neutral-300 max-w-2xl mx-auto" style="text-transform:none;font-family:var(--font-body);">
        Common questions about demolition services in Georgia. Can't find your answer? Call us at (843) 241-0787.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="container mx-auto px-4 max-w-4xl">
      <FAQAccordion faqs={allFaqs} client:load />
    </div>
  </section>

  <CTASection />
  <Footer slot="footer" />
</BaseLayout>
