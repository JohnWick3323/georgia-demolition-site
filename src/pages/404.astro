---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="404 - Page Not Found | Georgia Demolition & Removal" description="The page you're looking for could not be found.">
  <Header slot="header" />
  <section class="min-h-screen flex items-center justify-center bg-neutral-50 pt-20">
    <div class="text-center px-4">
      <div class="text-8xl font-bold font-heading text-primary-600 mb-4">404</div>
      <h1 class="text-3xl font-bold uppercase tracking-wide mb-4">Page Not Found</h1>
      <p class="text-neutral-600 mb-8 max-w-md mx-auto" style="text-transform:none;font-family:var(--font-body);">The page you're looking for doesn't exist or has been moved. Let us help you find what you need.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="bg-primary-600 hover:bg-primary-700 text-white font-bold px-8 py-3 rounded font-heading uppercase tracking-wide transition-all">Go Home</a>
        <a href="/services/" class="bg-white border border-neutral-300 text-neutral-900 font-bold px-8 py-3 rounded font-heading uppercase tracking-wide hover:border-primary-500 transition-all">Our Services</a>
        <a href="/contact/" class="bg-white border border-neutral-300 text-neutral-900 font-bold px-8 py-3 rounded font-heading uppercase tracking-wide hover:border-primary-500 transition-all">Contact Us</a>
      </div>
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>
