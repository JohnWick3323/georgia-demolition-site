---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<BaseLayout title="404 - Page Not Found | Georgia Demolition & Removal" description="The page you're looking for could not be found. Return to the home page or contact Georgia Demolition & Removal for help.">
  <Header slot="header" />
  <main class="min-h-[70vh] flex items-center justify-center pt-32 pb-20 bg-neutral-900 text-white relative overflow-hidden">
    <div class="container mx-auto px-4 relative z-10 text-center">
      <div class="max-w-2xl mx-auto">
        <span class="text-primary-500 font-black text-9xl leading-none mb-8 block select-none opacity-20">404</span>
        <h1 class="text-4xl md:text-6xl font-bold font-heading mb-6 leading-tight">
          Oops! This Page Has Been <span style="color:#F87171">Demolished</span>.
        </h1>
        <p class="text-xl text-neutral-400 mb-12 leading-relaxed" style="font-family:var(--font-body); text-transform:none">
          The page you're looking for seems to have disappeared or moved. Don't worry — our expert team is still available to help with your demolition needs.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12">
          <a href="/" class="flex items-center justify-center gap-3 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-xl font-bold transition-all shadow-xl hover:-translate-y-1 font-heading uppercase tracking-wide">
            Back to Home
          </a>
          <a href="/services/" class="flex items-center justify-center gap-3 bg-white text-neutral-900 px-8 py-4 rounded-xl font-bold transition-all hover:bg-neutral-100 shadow-xl hover:-translate-y-1 font-heading uppercase tracking-wide">
            Explore Services
          </a>
        </div>
        <div class="border-t border-neutral-800 pt-12 mt-12">
          <p class="text-sm font-bold text-neutral-500 uppercase tracking-widest mb-6 font-heading">Need immediate assistance?</p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-8">
            <a href={`tel:${site.phoneRaw}`} class="flex items-center gap-3 text-2xl font-bold text-white hover:text-primary-400 transition-colors font-heading">
              <div class="bg-primary-600/20 p-3 rounded-full text-primary-500">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              {site.phone}
            </a>
            <a href="/locations/" class="flex items-center gap-3 text-lg font-medium text-neutral-300 hover:text-white transition-colors">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#F87171" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              View Service Areas
            </a>
          </div>
        </div>
      </div>
    </div>
  </main>
  <Footer slot="footer" />
</BaseLayout>
